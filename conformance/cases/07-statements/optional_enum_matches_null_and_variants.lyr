//! run
//! since: 4.4.0
//! stdout:
//! | -1 0 12
// §7.6: a '?E' scrutinee admits both states — 'null' for the absent one and E's variants for
// the present one. Presence is established before any tag is read.
import std.io.console { println };

enum Shape { Dot, Rect { w: int, h: int } }

fn area(s: ?Shape): int {
    return match (s) {
        null => -1,
        Shape.Dot => 0,
        Shape.Rect { w, h } => w * h,
    };
}

fn main(): int {
    let missing: ?Shape = null;
    println(f"{area(missing)} {area(Shape.Dot)} {area(Shape.Rect { w = 3, h = 4 })}");
    return 0;
}
