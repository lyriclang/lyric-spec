//! check
//! since: 5.0.0
// 07 §1.6: a jump is its loop's wherever it stands — the 'else' of a 'let … else', an arm of a
// 'match' expression, a clause of a 'try' expression, a 'do' loop's block before its 'return'.
// The statement behind each loop is reached: no warning stands here.
import std.io { println };

enum Step { More(int), Done }

fn next(i: int): Step { return if (i < 3) Step.More(i) else Step.Done; }

struct Bad :: [Error] { fn message(): string { return "bad"; } }

fn risky(n: int): int throws Bad {
    if (n == 2) { throw Bad { }; }
    return n;
}

fn byLetElse(): int {
    var i = 0;
    while (true) {
        let .More(v) = next(i) else { break; };
        i = v + 1;
    }
    return i;
}

fn byArm(xs: int[]): int {
    var i = 0;
    while (true) {
        let v = match (xs[i]) {
            3 => { if (i > 0) { break; } 1 }
            _ => 2,
        };
        i = i + v;
    }
    return i;
}

fn byClause(): int {
    var total = 0;
    var i = 0;
    while (true) {
        let v = try risky(i) catch (_: Bad) { break; };
        total = total + v;
        i = i + 1;
    }
    return total;
}

fn byDo(c: bool): int {
    do {
        if (c) { break; }
        return 1;
    } while (true);
    return 2;
}

fn main(): void {
    println(f"{byLetElse()} {byArm([1, 1, 3])} {byClause()} {byDo(true)}");
}
