//! check
//! since: 1.0.0
//! error: LYS-SEM0018
// Lyric 5 §7.1 rule 5: after a loop the var is assigned only where every break assigned it.
fn f(c: bool): int {
    var y: int
    loop {
        if (c) {
            break
        }
        y = 1
        break
    }
    return y
}
println(f(true))
