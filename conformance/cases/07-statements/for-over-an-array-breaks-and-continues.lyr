//! run
//! stdout:
//! | 13
//! since: 5.0.0
// 07 §1, §2 rule 5: 'break' and 'continue' in the index loop.
import std.io { println };

fn main(): int {
    var seen = "";
    for (x in [1, 2, 3, 4, 5]) {
        if (x == 2) { continue; }
        if (x == 4) { break; }
        seen = seen + f"{x}";
    }
    println(seen);
    return 0;
}
