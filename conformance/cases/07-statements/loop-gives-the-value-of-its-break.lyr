//! run
//! stdout:
//! | 8
//! | -1
//! | true
//! since: 5.0.0
// 07 §1.2: a 'loop' is worth the value its 'break' gives — the values unified, or checked against
// the type the position expects.
import std.io { println };

fn firstEven(xs: int[]): int {
    var i = 0;
    return loop {
        if (i == xs.length()) { break -1; }
        if (xs[i] % 2 == 0) { break xs[i]; }
        i += 1;
    };
}

fn main(): void {
    println(f"{firstEven([3, 5, 8, 9])}");
    println(f"{firstEven([1, 3])}");
    let none: ?int = loop { break null; };
    println(f"{none == null}");
}
