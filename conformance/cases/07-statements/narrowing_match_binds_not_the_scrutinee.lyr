//! check
//! error: LYR-SEM0003
// §7.4: a match on ?T narrows through the BINDING pattern; the matched variable itself
// stays ?T in every arm. 'n => n + 1' works — '_ => x + 1' is this error.
fn main(): int {
    let x: ?int = 5;
    return match (x) {
        null => 0,
        _ => x + 1,
    };
}
