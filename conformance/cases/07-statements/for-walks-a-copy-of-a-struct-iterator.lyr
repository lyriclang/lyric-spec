//! run
//! stdout:
//! | 3 0
//! since: 5.0.0
// 07 §2.1: 'iter()' of an iterator is the iterator itself, a value — a loop over a struct
// iterator walks a copy, and the variable is where it was.
import std.io { println };

fn main(): int {
    var r = 0..10;
    var n = 0;
    for (i in r) {
        if (i == 3) { break; }
        n = n + 1;
    }
    println(f"{n} {r.next() ?? -1}");
    return 0;
}
