//! check
//! error: LYR-SEM0018
//! since: 5.0.0
// 07 §1.5: a 'break' that leaves before the assignment leaves the variable unassigned after the
// loop.
import std.io { println };

fn main(): void {
    var n: int;
    var i = 0;
    loop {
        i += 1;
        if (i > 5) { break; }
        if (i == 3) { n = i; break; }
    }
    println(f"{n}");
}
