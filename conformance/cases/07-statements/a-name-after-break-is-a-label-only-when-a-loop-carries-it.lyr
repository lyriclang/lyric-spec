//! run
//! stdout:
//! | 5
//! | 7
//! since: 5.0.0
// 07 §1.3: after 'break' a name is the label when a loop around carries it, and the value
// otherwise; in parentheses it is a value whatever it names. Labels share nothing with values.
import std.io { println };

fn main(): void {
    let v = 5;
    let a = loop { break v; };
    println(f"{a}");
    let outer = 7;
    let b = outer: loop {
        loop { break outer (outer); }
    };
    println(f"{b}");
}
