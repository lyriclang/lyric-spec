//! run
//! stdout:
//! | 1
//! | the loop threw first
//! since: 5.0.0
// 07 §2 rule 7, 10 §1 rule 9: a 'break' out of a loop over a generator closes it; what its defer
// threw on the way out comes out of the loop's close.
import std.io { println };

class First :: [Error] { fn message(): string { return "first"; } }
fn first(): void throws First { throw First { }; }

fn gen(): Coroutine<int> throws First {
    defer try first();
    yield 1;
    yield 2;
}

fn main(): void throws Error {
    try {
        for (x in gen()) {
            println(f"{x}");
            break;
        }
        println("left quietly");
    } catch (e) {
        println(f"the loop threw {e.message()}");
    }
}
