//! check
//! error: LYR-SEM0148
//! since: 5.0.0
// 07 §1.2: a value leaves only a 'loop' — a 'while' also ends when its condition does, and there
// would be no value then.
fn firstPositive(xs: int[]): int {
    var i = 0;
    while (i < xs.length()) {
        if (xs[i] > 0) { break xs[i]; }
        i += 1;
    }
    return 0;
}

fn main(): void { }
