//! check
//! warning: LYR-SEM0139
//! since: 5.0.0
// 07 §2 rule 6: nothing this loop walks throws — the mark is warned about.

struct Upto :: [Iterator] {
    type Item = int;
    var cur: int,
    end: int,

    mut fn next(): ?int {
        if (this.cur >= this.end) { return null; }
        this.cur = this.cur + 1;
        return this.cur - 1;
    }
}

fn main(): int {
    var s = 0;
    for (x in try Upto { cur = 0, end = 3 }) { s = s + x; }
    return s;
}
