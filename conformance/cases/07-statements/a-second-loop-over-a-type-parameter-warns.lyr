//! check
//! warning: LYR-SEM0162
//! since: 5.0.0
// 07 §2 rule 4: an iterator of a type parameter may be a class's — a second loop warns.

fn twice<I :: [Iterator<Item = int, Error = never>]>(it: I): int {
    var sum = 0;
    for (x in it) { sum = sum + x; }
    if (sum > 0) {
        for (x in it) { sum = sum + x; }
    }
    return sum;
}

fn main(): int {
    return 0;
}
