//! run
//! stdout:
//! | 6
//! | 10 20 30
//! | 13
//! | [2, 4, 6]
//! since: 1.0.0
// §7 rule 6: `for` over a list visits its elements in order, a fresh binding for each; writing an
// element is no change of the list.
var sum = 0
for (x in [1, 2, 3]) {
    sum += x
}
println(sum)
let fs: (fn() -> int)[] = []
for (x in [1, 2, 3]) {
    fs.push { x * 10 }
}
println(f"{fs[0]()} {fs[1]()} {fs[2]()}")
for (x in [1, 2, 3, 4, 5]) {
    if (x == 2) {
        continue
    }
    if (x == 4) {
        break
    }
    print(x)
}
println()
let xs = [1, 2, 3]
var k = 0
for (x in xs) {
    xs[k] = x * 2
    k += 1
}
println(xs)
