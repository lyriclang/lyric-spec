//! run
//! stdout:
//! | 8 0
//! | zero | small, flagged | small | big
//! | 3
//! | too big
//! | -1
//! since: 5.0.0
// 07 §3 rule 2 (the tail rule): an 'if' with its 'else', a 'match' and a 'loop' standing last in
// a value block are its value — in a lambda's block, an arm's and a clause's.
import std.io { println };

struct Bad :: [Error] { fn message(): string { return "too big"; } }

fn risky(n: int): int throws Bad {
    if (n > 2) { throw Bad { }; }
    return n;
}

fn classify(n: int, flag: bool): string {
    return match (n) {
        0 => "zero",
        _ => {
            let big = n > 100;
            match (big) {
                true => "big",
                false => if (flag) { "small, flagged" } else { "small" }
            }
        }
    };
}

fn firstOver(xs: int[], limit: int): int {
    let search = (from: int) => {
        var i = from;
        loop {
            if (xs[i] > limit) { break xs[i]; }
            i = i + 1;
        }
    };
    return search(0);
}

fn recover(n: int): int {
    return try risky(n) catch (e: Bad) {
        println(e.message());
        if (n > 10) { 99 } else { -1 }
    };
}

fn main(): void {
    let pick = (n: int) => {
        let d = n * 2;
        if (d > 5) { d } else { 0 }
    };
    println(f"{pick(4)} {pick(1)}");
    println(f"{classify(0, false)} | {classify(5, true)} | {classify(5, false)} | {classify(500, true)}");
    println(f"{firstOver([1, 2, 3, 4], 2)}");
    println(f"{recover(5)}");
}
