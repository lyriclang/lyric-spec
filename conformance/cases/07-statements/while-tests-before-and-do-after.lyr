//! run
//! stdout:
//! | 0 1
//! | big
//! since: 5.0.0
// 07 §5.2: a 'while' whose test fails runs no round, a 'do' runs one; 'else if' goes on.
import std.io { println };

fn main(): void {
    var w = 0;
    while (w > 0) { w = w + 1; }
    var d = 0;
    do { d = d + 1; } while (d > 5);
    println(f"{w} {d}");
    let n = 10;
    if (n < 3) {
        println("small");
    } else if (n < 7) {
        println("middle");
    } else {
        println("big");
    }
}
