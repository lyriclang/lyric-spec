//! run
//! stdout:
//! | 127
//! since: 5.0.0
// 07 §2 rule 5: an element is read at its pass — a write to a later one is seen.
import std.io { println };

fn main(): int {
    let xs = [1, 2, 3];
    var seen = "";
    for (x in xs) {
        if (x == 1) { xs[2] = 7; }
        seen = seen + f"{x}";
    }
    println(seen);
    return 0;
}
