//! check
//! warning: LYR-SEM0162
//! since: 5.0.0
// 07 §2 rule 4: the second loop over one class iterator goes on where the first stopped.

class Ticker :: [Iterator] {
    type Item = int;
    var n: int,

    mut fn next(): ?int {
        if (this.n == 0) { return null; }
        this.n = this.n - 1;
        return this.n;
    }
}

fn main(): int {
    let t = Ticker { n = 3 };
    var sum = 0;
    for (x in t) { sum = sum + x; }
    for (x in t) { sum = sum + x; }
    return sum;
}
