//! check
//! since: 5.0.0
// 07 §1.5: a 'loop' runs its block at least once, and a variable assigned at every 'break' that
// leaves it is assigned after it.
import std.io { println };

fn main(): void {
    var n: int;
    var i = 0;
    loop {
        i += 1;
        if (i == 3) { n = i * 2; break; }
    }
    println(f"{n}");
}
