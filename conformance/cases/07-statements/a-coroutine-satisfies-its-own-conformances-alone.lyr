//! check
//! error: LYR-SEM0028
//! since: 5.0.0
// 12 §Iteration: a coroutine conforms to Iterator and Closeable and nothing else.
import std.io { println };

fn gen(n: int): Coroutine<int> {
    defer { println("unwound"); }
    var i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
}

interface Named {
    fn name(): string;
}

fn greet<T :: [Named]>(t: T): string {
    return t.name();
}

fn main(): int {
    let g = greet(gen(1));
    return 0;
}
