//! run
//! stdout:
//! | body
//! | 0 1 2
//! | 6
//! since: 5.0.0
// 07 §6 rule 5: a loop inside a 'defer' body keeps its jumps, and a lambda there its 'return'.
import std.io { println };

fn main(): void {
    defer {
        var seen = "";
        for (i in 0..10) {
            if (i == 3) {
                break;
            }
            if (i > 0) {
                seen = seen + " ";
            }
            seen = seen + f"{i}";
            continue;
        }
        println(seen);
        let twice = (x: int) => {
            return x * 2;
        };
        println(f"{twice(3)}");
    }
    println("body");
}
