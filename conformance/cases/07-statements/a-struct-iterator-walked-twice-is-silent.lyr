//! check
//! since: 5.0.0
// 07 §2 rule 4: a struct iterator is walked as a copy per loop, and the second loop warns not.

struct Upto :: [Iterator] {
    type Item = int;
    var cur: int,
    end: int,

    mut fn next(): ?int {
        if (this.cur >= this.end) { return null; }
        this.cur = this.cur + 1;
        return this.cur - 1;
    }
}

fn main(): int {
    let u = Upto { cur = 0, end = 3 };
    var sum = 0;
    for (x in u) { sum = sum + x; }
    for (x in u) { sum = sum + x; }
    return sum;
}
