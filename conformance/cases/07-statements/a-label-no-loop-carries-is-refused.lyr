//! check
//! error: LYR-SEM0101
//! since: 5.0.0
// 07 §1.3: a jump to a label no loop around carries is refused — here a misspelled one, which no
// value is named like either.
fn main(): void {
    var n = 0;
    outer: while (n < 3) {
        while (true) { break outr; }
        n += 1;
    }
}
