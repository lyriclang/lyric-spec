//! run
//! stdout:
//! | 6 3
//! since: 5.0.0
// 07 §2 rule 6, 05 §8 rule 2: 'Error = never' fixed at the constraint — the loop throws nothing.
import std.io { println };

struct Upto :: [Iterator] {
    type Item = int;
    var cur: int,
    end: int,

    mut fn next(): ?int {
        if (this.cur >= this.end) { return null; }
        this.cur = this.cur + 1;
        return this.cur - 1;
    }
}

fn total<I :: [Iterator<Item = int, Error = never>]>(it: I): int {
    var s = 0;
    for (x in it) { s = s + x; }
    return s;
}

fn main(): int {
    println(f"{total(Upto { cur = 1, end = 4 })} {total(0..3)}");
    return 0;
}
