//! run
//! stdout:
//! | 1
//! | 3
//! since: 5.0.0
// 07 §2.1, §1: 'break' and 'continue' in a loop over the protocol.
import std.io { println };

struct Upto :: [Iterator] {
    type Item = int;
    var cur: int,
    end: int,

    mut fn next(): ?int {
        if (this.cur >= this.end) { return null; }
        this.cur = this.cur + 1;
        return this.cur - 1;
    }
}

fn main(): int {
    for (x in Upto { cur = 0, end = 10 }) {
        if (x % 2 == 0) { continue; }
        if (x > 3) { break; }
        println(f"{x}");
    }
    return 0;
}
