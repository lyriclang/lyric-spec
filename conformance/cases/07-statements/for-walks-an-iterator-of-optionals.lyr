//! run
//! stdout:
//! | -1 2 2
//! since: 5.0.0
// 07 §2.2, 03 §3.1: an Item '?int' walks — 'next()' answers '??int', and a present null is a
// value of the loop, not its end.
import std.io { println };

struct Maybes :: [Iterator] {
    type Item = ?int;
    var i: int,

    mut fn next(): ??int {
        this.i = this.i + 1;
        if (this.i == 1) {
            let none: ?int = null;
            return none;
        }
        if (this.i == 2) { return 2; }
        return null;
    }
}

fn main(): int {
    var seen = "";
    var n = 0;
    for (x in Maybes { i = 0 }) {
        let v = x ?? -1;
        seen = seen + f"{v} ";
        n = n + 1;
    }
    println(f"{seen}{n}");
    return 0;
}
