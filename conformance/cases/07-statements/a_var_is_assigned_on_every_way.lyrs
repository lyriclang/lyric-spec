//! run
//! since: 1.0.0
//! stdout:
//! | 2
//! | 5
//! | 3
// Lyric 5 §7.1 rule 5: a var without a value is read where every way to the read assigns it —
// both branches of an if, a branch that returns adding nothing, a loop's every break.
fn pick(c: bool): int {
    var n: int
    if (c) {
        n = 1
    } else {
        n = 2
    }
    return n
}
fn early(c: bool): int {
    var n: int
    if (c) {
        n = 5
    } else {
        return -1
    }
    return n
}
fn looped(): int {
    var y: int
    loop {
        y = 3
        break
    }
    return y
}
println(pick(false))
println(early(true))
println(looped())
