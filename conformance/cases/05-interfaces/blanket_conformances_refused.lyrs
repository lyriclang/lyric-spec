//! check
//! error: LYS-SEM0128
//! error: LYS-SEM0042
//! error: LYS-SEM0020
//! error: LYS-SEM0129
//! error: LYS-SEM0133
//! since: 1.0.0
// §5 rule 12: a blanket block that conforms answers what the interface asks, implements it as
// declared at its target and answers nothing else; a second one that gives the interface is
// refused, whether or not a type could meet both.
interface Named {
    fn name(): string
}
interface Greets {
    type Tone
    fn greet(): string
    fn tone(): Self.Tone
}
extend<T :: [Named]> T :: [Greets] {
    type Volume = int
    fn greet(): int = 1
}
interface Other {
    fn other(): int
}
extend<U :: [Other]> U :: [Greets] {
    type Tone = int
    fn greet(): string = "x"
    fn tone(): int = 0
}
