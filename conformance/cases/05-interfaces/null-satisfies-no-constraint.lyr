//! check
//! error: LYR-SEM0028
//! since: 5.0.0
// 03 §9.1.3 (M8a S14): 'null' alone binds 'T' to no type a constraint holds for — it passed every
// constraint before, and the lowering failed on it.
fn shown<T :: [Display]>(x: T): string {
    return x.show();
}

fn main(): void {
    let s = shown(null);
}
