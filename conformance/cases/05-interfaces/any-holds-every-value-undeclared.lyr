//! run
//! stdout:
//! | 3 true false true
//! since: 5.0.0
// 05 §9.1: a struct, a class and an enum are an 'Any' at the transition, nothing declared; 'is' takes them out.
import std.io { println };
import std.core { Any };

interface Shape { fn area(): int; }
struct Circle :: [Shape] { r: int, fn area(): int { return 3 * this.r * this.r; } }
class Rect :: [Shape] { w: int, h: int, fn area(): int { return this.w * this.h; } }
enum Dir :: [Shape] { Up, Down; fn area(): int { return 0; } }

fn main(): int {
    let xs: Any[] = [Circle { r = 1 }, Rect { w = 1, h = 2 }, Dir.Up];
    let a = xs[0];
    let b = xs[1];
    println(f"{xs.length()} {a is Circle} {b is Circle} {xs[2] is Dir}");
    return 0;
}
