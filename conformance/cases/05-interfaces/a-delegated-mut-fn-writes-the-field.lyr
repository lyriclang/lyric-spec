//! run
//! stdout:
//! | 2 2 | 1 | 1 | 2 | 1 3
//! since: 5.0.0
// 05 §5 rule 1: a delegated member is forwarded as if 'mut fn bump() { this.inner.bump(); }'
// were written - a 'mut fn' writes the field. On the type, written qualified, through a
// constraint with a place, from the interface's default; in a struct and in a class.
import std.io { println };

interface Counter {
    mut fn bump(): void;
    fn get(): int;
    mut fn twice(): void { this.bump(); this.bump(); }
}

struct Inner :: [Counter] {
    var n: int,
    mut fn bump(): void { this.n += 1; }
    fn get(): int { return this.n; }
}

struct Outer :: [Counter by inner] {
    var inner: Inner,
}

class Shared :: [Counter by inner] {
    var inner: Inner,
}

fn bumped<T :: [Counter]>(&t: T): void { t.bump(); }

fn main(): void {
    var o = Outer { inner = Inner { n = 0 } };
    o.bump();
    o.bump();
    var p = Outer { inner = Inner { n = 0 } };
    Counter.bump(p);
    var q = Outer { inner = Inner { n = 0 } };
    bumped(&q);
    var r = Outer { inner = Inner { n = 0 } };
    r.twice();
    let s = Shared { inner = Inner { n = 0 } };
    s.bump();
    let first = s.inner.n;
    s.twice();
    println(f"{o.get()} {o.inner.n} | {p.inner.n} | {q.inner.n} | {r.inner.n} | {first} {s.get()}");
}
