//! run
//! stdout:
//! | a 3
//! since: 5.0.0
// 05 §13 rule 2: a fixation names parameters inside a type — the receiver's Item matched against
// (K, V) binds both.
import std.io { println };

extend<I :: [Iterator<Item = (K, V)>], K, V> I {
    fn firstKey(): ?K throws I.Error {
        var it = this;
        if (let pair = try it.next()) {
            return pair.0;
        }
        return null;
    }
}

fn main(): void {
    let pairs = [("a", 1), ("b", 2)];
    let key = pairs.iter().firstKey() ?? "-";
    let count = [(1, 2.0), (3, 4.0), (5, 6.0)].iter().count();
    println(f"{key} {count}");
}
