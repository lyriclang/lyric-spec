//! run
//! stdout:
//! | 7 7 7
//! since: 5.0.0
// 05 §3.3: the static call, the call through the table and the call through a constraint reach the one function.
import std.io { println };

interface Counter { fn count(): int; }
class Bag :: [Counter] { var n: int, fn count(): int { return this.n; } }

fn viaTable(c: Counter): int { return c.count(); }
fn viaConstraint<T :: [Counter]>(c: T): int { return c.count(); }

fn main(): int {
    let bag = Bag { n = 7 };
    println(f"{bag.count()} {viaTable(bag)} {viaConstraint(bag)}");
    return 0;
}
