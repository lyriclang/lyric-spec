// 05 §2.3: one parameter of the interface's type, two classes behind it, two implementations.
import std.io { println };

interface Damageable { mut fn takeDamage(amount: int); fn getHp(): int; }

class Player :: [Damageable] {
    var hp: int,
    mut fn takeDamage(amount: int) { this.hp -= amount; }
    fn getHp(): int { return this.hp; }
}

class Wall :: [Damageable] {
    var hp: int,
    mut fn takeDamage(amount: int) { this.hp -= amount / 2; }
    fn getHp(): int { return this.hp; }
}

fn hit(target: Damageable, amount: int): int { target.takeDamage(amount); return target.getHp(); }

fn main(): int {
    let a = hit(Player { hp = 100 }, 40);
    let b = hit(Wall { hp = 100 }, 40);
    println(f"{a} {b}");
    return 0;
}
