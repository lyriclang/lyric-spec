// §5 rule 8: `==` over a type parameter asks `Equatable`, so do the comparing methods; a class
// compares only as an `Identity` or an `Equatable`; an `equals` of another signature implements
// nothing; `Equatable` is a constraint only.
fn same<T>(a: T, b: T): bool = a == b
fn has<T>(xs: T[], x: T): bool = xs.contains(x)
class K {
    n: int
}
let k = K { n = 1 } == K { n = 1 }
class W :: Equatable {
    n: int
    fn equals(o: int): bool = true
}
let e: Equatable = 1
