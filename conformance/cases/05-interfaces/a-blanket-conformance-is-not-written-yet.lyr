//! check
//! error: LYR-SEM0047
//! since: 5.0.0
// 05 §13 rule 7: a conformance through a blanket block is not written yet; the members of a
// blanket block without one are there.

interface Named {
    fn name(): string;
}

interface Greeter {
    fn greeting(): string;
}

struct Cat :: [Named] {
    fn name(): string {
        return "cat";
    }
}

extend<T :: [Named]> T {
    fn hello(): string {
        return "hello " + this.name();
    }
}

extend<T :: [Named]> T :: [Greeter] {
    fn greeting(): string {
        return this.hello();
    }
}

fn main(): void {
    let _ = Cat { }.hello();
}
