//! check
//! error: LYS-SEM0059
//! stderr-has: '==' does not compare Box<C>
//! since: 1.0.0
// §5 rule 8: a conformance a block gives where the arguments meet its constraints is no
// conformance where they do not — `Box<C>` of a class `C` that is no Equatable compares not.
class Box<T> {
    v: T,
}
extend<T :: [Equatable]> Box<T> :: Equatable {
    fn equals(o: Box<T>): bool = this.v == o.v
}
class C {
    n: int,
}
let a = Box { v = C { n = 1 } }
println(a == a)
