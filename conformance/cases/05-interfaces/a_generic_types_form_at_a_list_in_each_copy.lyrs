//! run
//! stdout:
//! | Box { v = [3] } [3]
//! | Box { v = ["s"] } ["s"]
//! | Box { v = [[1, 2]] } [[1, 2]]
//! since: 1.0.0
// §5 rule 9: a generic type's form in a generic body whose argument is a list of the body's own
// parameter, `Box<T[]>`, is its own in each copy of the body — at a scalar, a string, a list.
class Box<T> {
    v: T,
}
fn k<T>(x: T) {
    let b: Box<T[]> = Box { v = [x] }
    println(f"{b} {b.v}")
}
k(3)
k("s")
k([1, 2])
