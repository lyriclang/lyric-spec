//! check
//! error: LYR-SEM0003
//! since: 5.0.0
// 05 §12 rule 9: 'g[0] += "y"' would evaluate the index twice, through 'index' and 'setIndex'.

class Grid :: [IndexSet<int>] {
    type Output = string;
    cells: string[],

    fn index(k: int): string {
        return this.cells[k];
    }

    mut fn setIndex(k: int, v: string): void {
        this.cells[k] = v;
    }
}

fn main(): void {
    let g = Grid { cells = ["a"] };
    g[0] += "y";
}
