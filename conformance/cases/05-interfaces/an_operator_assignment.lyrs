//! run
//! stdout:
//! | V { x = 3.0 }
//! | V { x = 1.0 } 1
//! | V { x = 4.0 }
//! since: 1.0.0
// §5 rule 17 (Lyric 5 §12 rule 4): `a op= b` is `a = a op b` — on a variable, a field, a list's
// element —, what leads to the place evaluated once.
struct V :: [Add, Sub] {
    x: float,
    fn add(rhs: V): V = V { x = this.x + rhs.x }
    fn sub(rhs: V): V = V { x = this.x - rhs.x }
}
let a = V { x = 1.0 }
let b = V { x = 3.0 }
var c = a
c += b
c -= a
println(c)
class Holder {
    var v: V = V { x = 0.0 }
}
let holder = Holder { }
var picks = 0
fn pick(): Holder {
    picks += 1
    return holder
}
pick().v += a
println(f"{holder.v} {picks}")
let vs = [a, b]
vs[1] += a
println(vs[1])
