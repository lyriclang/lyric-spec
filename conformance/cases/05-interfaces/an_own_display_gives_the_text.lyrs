//! run
//! since: 1.0.0
//! stdout:
//! | R=2
//! | R=2 R=2
//! | [R { v = 2 }]
//! | sq3 9
//! | <R=7> <4> <s> <c> <true> <1.5>
//! | 5 c s
// §5 rule 21: `{x}` and `println(x)` of a value whose type is a `Display` print its `show()` — a
// type that lists it, an interface value of an interface that extends it, a value of a type
// parameter it bounds; the scalars and the string are `Display`. A list prints its elements'
// Debug forms.
struct R :: Display {
    v: int
    fn show(): string = f"R={this.v}"
}
interface Shape :: Display {
    fn area(): int
}
struct Sq :: Shape {
    s: int
    fn area(): int = this.s * this.s
    fn show(): string = f"sq{this.s}"
}
fn angled<T :: [Display]>(x: T): string = f"<{x}>"

let r = R { v = 2 }
println(r)
println(f"{r} {r.show()}")
println([r])
let sh: Shape = Sq { s = 3 }
println(f"{sh} {sh.area()}")
println(f"{angled(R { v = 7 })} {angled(4)} {angled("s")} {angled('c')} {angled(true)} {angled(1.5)}")
println(f"{5.show()} {'c'.show()} {"s".show()}")
