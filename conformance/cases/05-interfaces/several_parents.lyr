//! run
//! since: 2.16.0
//! stdout:
//! | 3
//! | 10
//! | 15
import std.io.console { println };

interface Counted {
    fn count(): int;
}

interface Scaled {
    fn scale(): int;

    fn scaledTwice(): int {
        return this.scale() * 2;
    }
}

interface Item :: [Counted, Scaled] {
    fn total(): int {
        return this.count() * this.scale();
    }
}

class Box :: [Item] {
    n: int = 0,

    fn count(): int {
        return 3;
    }

    fn scale(): int {
        return 5;
    }
}

fn viaCounted(c: Counted): int {
    return c.count();
}

fn viaScaled(s: Scaled): int {
    return s.scaledTwice();
}

fn viaItem(i: Item): int {
    return i.total();
}

fn main(): int {
    let b = Box { };
    println(viaCounted(b));
    println(viaScaled(b));
    println(viaItem(b));
    return 0;
}
