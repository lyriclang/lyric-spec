//! run
//! stdout:
//! | 5 text bc "x"
//! | -3|200|1.5|z|false|
//! | [1][two][3.5]
//! since: 5.0.0
// 05 §2 rule 1: a number, a bool, a char, a string and a view are values of the interfaces they
// conform to through std.core's blocks — bound, passed to a variadic tail, held in a list.
import std.collections { List };
import std.io { println };

fn shown(xs: Display...): string {
    var text = "";
    for (x in xs) {
        text = f"{text}{x}|";
    }
    return text;
}

fn main(): void {
    let n: Display = 5;
    let s: Display = "text";
    let v: Display = "abcd"[1..3];
    let q: Debug = "x";
    println(f"{n} {s} {v} {q:?}");
    let small: int8 = -3;
    let byte: uint8 = 200;
    let narrow: float32 = 1.5;
    println(shown(small, byte, narrow, 'z', false));
    let xs: List<Display> = [1, "two", 3.5];
    var text = "";
    for (x in xs) {
        text = f"{text}[{x}]";
    }
    println(text);
}
