//! check
//! error: LYS-SEM0124
//! since: 1.0.0
// §5 rule 12 (Lyric 5 §13 rule 1): a blanket block holds no constant; a generic block's target is
// its type at the block's parameters, in their order.
interface Named {
    fn name(): string
}
extend<T :: [Named]> T {
    static let x: int = 1
}
struct Pair<A, B> {
    a: A,
    b: B,
}
extend<T> Pair<T, int> {
    fn f(): int = 1
}
