//! check
//! error: LYR-SEM0133
//! since: 5.0.0
// 05 §13 rule 8: 'int[]' is a Named, so the blanket reaches it, and 'T[]'s block overlaps it.

interface Named {
    fn name(): string;
}

interface Greeter {
    fn greeting(): string;
}

extend<T :: [Named]> T :: [Greeter] {
    fn greeting(): string {
        return "hello " + this.name();
    }
}

extend<T> T[] :: [Greeter] {
    fn greeting(): string {
        return "hello items";
    }
}

extend int[] :: [Named] {
    fn name(): string {
        return "numbers";
    }
}

fn main(): void {
}
