//! check
//! error: LYS-SEM0012
//! error: LYS-SEM0133
//! since: 1.0.0
// §5 rule 12: another instance has none of a block's members; an instance whose template conforms
// already conforms at a second site.
interface Show {
    fn show(): string
}
struct Box<T> {
    v: T,
}
extend Box<int> {
    fn plus(): int = this.v + 1
}
extend<T> Box<T> :: Show {
    fn show(): string = "any box"
}
extend Box<string> :: Show {
    fn show(): string = "string box"
}
let s: Box<string> = Box { v = "a" }
println(s.plus())
println(["a"].plus())
