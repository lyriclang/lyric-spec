//! check
//! since: 1.0.0
//! error: LYS-SEM0020
//! error: LYS-SEM0042
//! error: LYS-SEM0001
//! stderr-has: 'V' does not implement 'Mul.mul'
//! stderr-has: 'W' answers 'Add<W>.Out' with int, where 'Ring' fixes it to W
//! stderr-has: expected T, found T.Out
// §5 rule 22 (Lyric 5 §8 rule 7): a type that lists an interface implements its parents over
// `Self` and answers as they are fixed; a parent not fixed answers its own way, so through a
// constraint `a + b` is a `T.Out`, no `T`.
interface Ring :: [Add<Out = Self>, Mul<Out = Self>] {
    static let zero: Self
}
struct V :: Ring {
    x: int
    static let zero: V = V { x = 0 }
    fn add(o: V): V = V { x = this.x + o.x }
}
struct W :: [Ring, Add] {
    x: int
    type Out = int
    static let zero: W = W { x = 0 }
    fn add(o: W): int = this.x + o.x
    fn mul(o: W): W = W { x = this.x * o.x }
}
interface Summable :: [Add] {
    static let zero: Self
}
fn total<T :: [Summable]>(a: T, b: T): T {
    var t = T.zero
    t = a + b
    return t
}
