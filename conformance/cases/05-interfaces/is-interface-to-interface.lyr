//! run
//! stdout:
//! | true false circle
//! since: 5.0.0
// 05 §9.2: 'is' against an interface searches the concrete type's conformance list; the name narrows to it.
import std.io { println };

interface Shape { fn area(): int; }
interface Named { fn name(): string; }
struct Circle :: [Shape, Named] { r: int, fn area(): int { return 1; } fn name(): string { return "circle"; } }
class Rect :: [Shape] { w: int, fn area(): int { return 2; } }

fn main(): int {
    let c: Shape = Circle { r = 1 };
    let r: Shape = Rect { w = 1 };
    var named = "none";
    if (c is Named) { named = c.name(); }
    println(f"{c is Named} {r is Named} {named}");
    return 0;
}
