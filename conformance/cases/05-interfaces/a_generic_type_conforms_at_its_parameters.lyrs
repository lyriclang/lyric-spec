//! run
//! stdout:
//! | 7
//! | 7
//! | b
//! since: 1.0.0
// §5 rule 15: a parent at the child's arguments; a generic type conforms at its own parameters,
// each instance at its arguments.
interface Source<T> {
    fn take(): T
}
interface Store<T> :: Source<T> {
    fn put(x: T)
}
class Cell<T> :: Store<T> {
    var v: T
    fn take(): T = this.v
    fn put(x: T) {
        this.v = x
    }
}
let c: Cell<int> = Cell { v = 1 }
let s: Store<int> = c
s.put(7)
println(s.take())
let src: Source<int> = c
println(src.take())
fn drain<T, S :: [Store<T>]>(s: S, x: T): T {
    s.put(x)
    return s.take()
}
let d: Cell<string> = Cell { v = "a" }
println(drain(d, "b"))
