//! check
//! error: LYR-PAR0066
//! since: 5.0.0
// 02 §1 rule 6: several interfaces after '::' as a list without brackets are refused as well.
interface Named {
    fn name(): string;
}

interface Shown {
    fn show(): string;
}

struct User :: Named, Shown {
    fn name(): string { return "u"; }
    fn show(): string { return "U"; }
}

fn main(): void {
}
