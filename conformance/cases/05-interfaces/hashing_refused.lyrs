//! check
//! error: LYS-SEM0028
//! since: 1.0.0
// §5 rule 20 (Lyric 5 12 §Hashing): a class hashes by its identity or through `:: Hashable`; a
// list hashes not.
fn hashOf<T :: [Hashable]>(x: T): int {
    let h = Hasher { }
    x.hash(h)
    return h.finish()
}
class Plain {
    n: int = 0
}
let c = hashOf(Plain { })
let d = hashOf([1, 2])
