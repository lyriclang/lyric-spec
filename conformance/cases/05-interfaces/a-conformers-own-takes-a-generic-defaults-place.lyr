//! run
//! stdout:
//! | a:1 B!1 | a:7 B!7 | a:x a:x | B!x B!x | B!2 B!2
//! since: 5.0.0
// 05 §1 rule 5: a generic member with a default is the conformer's where it writes none, and its
// own where it writes one - on the type, through a constraint, and from the interface's other
// defaults: 'twice' is nobody's own, and reaches the 'tag' of the type it runs for.
import std.io { println };

interface Shower {
    fn name(): string;
    fn tag<T :: [Display]>(x: T): string { return f"{this.name()}:{x}"; }
    fn twice<T :: [Display]>(x: T): string { return f"{this.tag(x)} {this.tag(x)}"; }
}

struct A :: [Shower] {
    n: int,
    fn name(): string { return "a"; }
}

struct B :: [Shower] {
    n: int,
    fn name(): string { return "b"; }
    fn tag<T :: [Display]>(x: T): string { return f"B!{x}"; }
}

fn through<S :: [Shower]>(s: S): string { return s.tag(7); }
fn both<S :: [Shower]>(s: S): string { return s.twice("x"); }

fn main(): void {
    let a = A { n = 0 };
    let b = B { n = 0 };
    println(f"{a.tag(1)} {b.tag(1)} | {through(a)} {through(b)} | {both(a)} | {both(b)} | {b.twice(2)}");
}
