//! run
//! stdout:
//! | 1 ["x"] 5 ["x", "y"]
//! | 1 9 8 7 6
//! | Point { x = 1, y = 1.5, name = "p" } 1
//! since: 1.0.0
// §5 rule 19 (Lyric 5 §14 rules 1–3): `clone` of a type that lists Clone without one copies the
// value fields and clones the reference fields — an object, a list, an optional's value, a tuple's
// elements, an enum's payload.
class Counter :: [Clone] {
    var n: int = 0
    tags: string[] = []
}
class Holder :: [Clone] {
    var c: Counter
    p: (int, Counter)
    o: ?Counter
    xs: Counter[]
}
let a = Counter { n = 1, tags = ["x"] }
let b = a.clone()
b.n = 5
b.tags.push("y")
println(f"{a.n} {a.tags} {b.n} {b.tags}")
let h = Holder { c = a, p = (1, a), o = a, xs = [a] }
let h2 = h.clone()
h2.c.n = 9
h2.p.1.n = 8
h2.o!.n = 7
h2.xs[0].n = 6
println(f"{a.n} {h2.c.n} {h2.p.1.n} {h2.o!.n} {h2.xs[0].n}")
struct Point :: [Clone] {
    x: int,
    y: float = 1.5,
    name: string,
}
enum Shape :: [Clone] {
    Dot,
    Bag(Counter),
}
let s2 = Shape.Bag(a).clone()
match (s2) {
    .Bag(c) => {
        c.n = 77
    }
    _ => { }
}
println(f"{Point { x = 1, name = "p" }.clone()} {a.n}")
