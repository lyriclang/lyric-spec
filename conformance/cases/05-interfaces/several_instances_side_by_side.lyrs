//! run
//! stdout:
//! | #3 x 1.5 #4 y
//! | int 1 str a int 2 str b
//! | int 5 str d int 9
//! | cell int 4 cell str d
//! since: 1.0.0
// §5 rule 18 (Lyric 5 §3 rule 5): members of one name and count answering instances of one
// generic interface stand side by side; a call chooses by the arguments' types, a literal its
// default type; a constraint by the instance it names, an interface value by its table.
interface From<T> {
    static fn from(v: T): Self
}
struct Label :: [From<int>, From<string>, From<float>] {
    text: string,
    static fn from(v: int): Label = Label { text = f"#{v}" }
    static fn from(v: string): Label = Label { text = v }
    static fn from(v: float): Label = Label { text = f"{v}" }
}
fn make<U :: [From<int>]>(n: int): U = U.from(n)
fn makeS<U :: [From<string>]>(s: string): U = U.from(s)
let l: Label = make(4)
let m: Label = makeS("y")
println(f"{Label.from(3).text} {Label.from("x").text} {Label.from(1.5).text} {l.text} {m.text}")
interface Show<T> {
    fn show(x: T): string
}
class Fmt :: [Show<int>, Show<string>] {
    fn show(x: int): string = f"int {x}"
    fn show(x: string): string = f"str {x}"
}
let f = Fmt { }
let a: Show<int> = f
let b: Show<string> = f
println(f"{f.show(1)} {f.show("a")} {a.show(2)} {b.show("b")}")
fn viaInt<S :: [Show<int>]>(s: S): string = s.show(5)
fn viaString<S :: [Show<string>]>(s: S): string = s.show("d")
let k: fn(int) -> string = f.show
println(f"{viaInt(f)} {viaString(f)} {k(9)}")
struct Cell<T> :: [Show<int>, Show<string>] {
    v: T,
    fn show(x: int): string = f"cell int {x}"
    fn show(x: string): string = f"cell str {x}"
}
let c: Show<int> = Cell { v = true }
println(f"{c.show(4)} {viaString(Cell { v = 1 })}")
