//! run
//! stdout:
//! | true true true
//! | true xxs
//! since: 1.0.0
// §5 rule 8 (Lyric 5 §12 rule 10): `x in xs` through the right operand's `Contains<T>` — a type
// of the program's, a list's over `T :: [Equatable]` —, `x` evaluated before `xs`.
struct Bag :: Contains<int> {
    items: int[],
    fn contains(x: int): bool = x in this.items
}
fn has<T :: [Equatable]>(xs: T[], x: T): bool = x in xs
println(f"{3 in Bag { items = [1, 3] }} {4 !in Bag { items = [1, 3] }} {has(["a"], "a")}")
var order = ""
fn needle(): int {
    order += "x"
    return 2
}
fn hay(): int[] {
    order += "xs"
    return [2]
}
let found = needle() in hay()
println(f"{found} {order}")
