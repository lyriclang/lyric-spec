//! check
//! error: LYS-SEM0028
//! since: 1.0.0
// §5 rule 15: `T :: [Combine<T>]` asks the instance at `T` — a `B :: Combine<int>` is none; the
// interface at a parameter of its own spelling is no template any instance meets.
interface Combine<With> {
    fn combine(o: With): string
}
struct B :: Combine<int> {
    fn combine(o: int): string = f"B+{o}"
}
fn written<T :: [Combine<T>]>(a: T, b: T): string = a.combine(b)
let s = written(B { }, B { })
