//! run
//! stdout:
//! | false true
//! since: 1.0.0
// §5 rule 8 and 19: a member the compiler synthesizes, called through a constraint over an object
// — no table holds it, the copy is the type's own.
class C :: [Equatable] {
    n: int = 0
}
fn same<T :: [Equatable]>(a: T, b: T): bool = a.equals(b)
println(f"{same(C { }, C { n = 1 })} {same(C { }, C { })}")
