//! run
//! since: 3.5.0
//! exit: 6
// §5.2a / §5.3: a default method of a GENERIC interface is a method like any other —
// reachable through a constraint and through an interface VALUE alike. (Neither route
// had a lowering before 2.17; this pins the wall's absence.)
interface Source<T> {
    fn get(): T;
    fn twice(): T { return this.get(); }
}

class Ints :: [Source<int>] {
    n: int,
    fn get(): int { return this.n; }
}

fn viaValue(s: Source<int>): int { return s.twice(); }

fn viaConstraint<S :: [Source<int>]>(s: S): int { return s.twice(); }

fn main(): int {
    let i = Ints { n = 3 };
    return viaValue(i) + viaConstraint(i);
}
