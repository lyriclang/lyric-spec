//! run
//! stdout:
//! | 3 2 20
//! since: 5.0.0
// 05 §13.6: a tuple of fixed arity through destructuring 'this'; 'Slice<T>' as a shape.
import std.io { println };

extend<A, B> (A, B) {
    fn firstOf(): A {
        let (a, _) = this;
        return a;
    }
}

extend<T> Slice<T> {
    fn count(): int { return this.length(); }
    fn head(): T { return this[0]; }
}

fn main(): int {
    let p = (3, "x");
    let v = [10, 20, 30][1..];
    println(f"{p.firstOf()} {v.count()} {v.head()}");
    return 0;
}
