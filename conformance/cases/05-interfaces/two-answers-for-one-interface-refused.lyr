//! check
//! error: LYR-SEM0133
//! since: 5.0.0
// 05 §8.3: one answer per type and interface — a second conformance block is refused as a whole,
// its answer with it, and that is the one error.
interface Container { type Item; fn first(): Self.Item; }
struct B :: [Container] { type Item = int; v: int, fn first(): int { return this.v; } }
extend B :: [Container] { type Item = string; }

fn main(): int { return 0; }
