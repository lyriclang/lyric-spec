//! check
//! error: LYR-SEM0121
//! since: 5.0.0
// 05 §3.1: an inherent extension cannot stand beside a default of a conformed interface — it would be a second function of the name.
interface Tagged { fn tag(): int { return 1; } }
struct V :: [Tagged] { x: int }
extend V { fn tag(): int { return 2; } }

fn main(): int { return 0; }
