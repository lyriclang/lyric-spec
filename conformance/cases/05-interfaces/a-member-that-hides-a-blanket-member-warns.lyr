//! check
//! warning: LYR-SEM0168
//! since: 5.0.0
// 05 §13 rule 7: the type's member that hides a blanket member is warned about where it stands -
// two functions of one name exist for the type.

interface Named {
    fn name(): string;
}

struct Cat :: [Named] {
    fn name(): string {
        return "cat";
    }

    fn greeting(): string {
        return "meow";
    }
}

extend<T :: [Named]> T {
    fn greeting(): string {
        return "hello " + this.name();
    }
}

fn main(): void {
}
