//! run
//! stdout:
//! | true false true false true
//! | true false true false false
//! | true true true
//! since: 1.0.0
// §5 rule 20 (Lyric 5 05 §14, 12 §Hashing; Script 03 Eq): a scalar, a string, a struct, an enum
// and a tuple of hashable parts hash by themselves — equal values alike; an enum its variant's
// position, then its payload; a class through `:: Hashable` by its fields.
fn hashOf<T :: [Hashable]>(x: T): int {
    let h = Hasher { }
    x.hash(h)
    return h.finish()
}
struct P {
    x: int,
    name: string,
}
enum E {
    A(int),
    B(int),
}
class Key :: [Hashable, Equatable] {
    id: int
}
println(f"{hashOf(1) == hashOf(1)} {hashOf(1) == hashOf(2)} {hashOf("ab") == hashOf("ab")} {hashOf("ab") == hashOf("ba")} {hashOf('c') == hashOf('c')}")
println(f"{hashOf(P { x = 1, name = "a" }) == hashOf(P { x = 1, name = "a" })} {hashOf(P { x = 1, name = "a" }) == hashOf(P { x = 2, name = "a" })} {hashOf(E.A(1)) == hashOf(E.A(1))} {hashOf(E.A(1)) == hashOf(E.B(1))} {hashOf(P { x = 1, name = "a" }) == hashOf(P { x = 1, name = "b" })}")
let h = Hasher { }
(1, true).hash(h)
let h2 = Hasher { }
(1, true).hash(h2)
let none: ?int = null
println(f"{h.finish() == h2.finish()} {hashOf(Key { id = 3 }) == hashOf(Key { id = 3 })} {hashOf(none) == hashOf(none)}")
