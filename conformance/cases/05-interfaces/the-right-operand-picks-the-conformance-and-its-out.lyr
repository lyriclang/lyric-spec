//! run
//! stdout:
//! | 3 6 4.5
//! since: 5.0.0
// 05 §12.2: 'Mul<int>' own with 'Out = Self', 'Mul<float>' in a block answering 'type Out = float'.
import std.io { println };
import std.core { Add, Sub, Mul, Neg };

struct V :: [Add, Sub, Mul<int>, Neg, Equatable, Ordered, Display] {
    x: int,
    y: int,
    fn add(rhs: V): V { return V { x = this.x + rhs.x, y = this.y + rhs.y }; }
    fn sub(rhs: V): V { return V { x = this.x - rhs.x, y = this.y - rhs.y }; }
    fn mul(rhs: int): V { return V { x = this.x * rhs, y = this.y * rhs }; }
    fn neg(): V { return V { x = -this.x, y = -this.y }; }
    fn equals(o: V): bool { return this.x == o.x && this.y == o.y; }
    fn compare(o: V): ?Ordering {
        let a = this.x * this.x + this.y * this.y;
        let b = o.x * o.x + o.y * o.y;
        if (a < b) { return Ordering.Less; }
        if (a > b) { return Ordering.Greater; }
        return Ordering.Equal;
    }
    fn show(): string { return f"({this.x}, {this.y})"; }
}

extend V :: [Mul<float>] {
    type Out = float;
    fn mul(rhs: float): float { return (this.x as float) * rhs; }
}

fn main(): int {
    let a = V { x = 1, y = 2 };
    let b = V { x = 3, y = 4 };
    let m = a * 3;
    println(f"{m.x} {m.y} {b * 1.5}");
    return 0;
}
