//! run
//! stdout:
//! | 2
//! | 3
//! | box 4
//! | box 4
//! | true false
//! | 2 strings
//! | 1 strings
//! since: 1.0.0
// §5 rule 12 (Lyric 5 §13 rules 1–3): a block on one instance — of a generic type named before
// its declaration, of a list type — checked at the instance, its conformance that instance's.
interface Show {
    fn show(): string
}
extend Box<int> {
    fn plus(): int = this.v + 1
}
extend Box<int> :: Show {
    fn show(): string = f"box {this.v}"
}
struct Box<T> {
    v: T,
}
extend int[] {
    fn total(): int {
        var t = 0
        for (x in this) {
            t += x
        }
        return t
    }
}
extend string[] :: Show {
    fn show(): string = f"{this.length()} strings"
}
fn shown<S :: [Show]>(s: S): string = s.show()
let b: Box<int> = Box { v = 1 }
println(b.plus())
println([1, 2].total())
let four: Box<int> = Box { v = 4 }
println(shown(four))
let v: Show = four
println(v.show())
let a: Any = four
let o: Any = Box { v = "x" }
println(f"{a is Show} {o is Show}")
println(shown(["a", "b"]))
let w: Show = ["c"]
println(w.show())
