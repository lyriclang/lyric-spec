//! run
//! stdout:
//! | 3
//! since: 5.0.0
// 05 §8 rule 4: an associated type satisfies the constraints its bound reaches.
import std.io { println };

interface It {
    type Item;
    mut fn next(): ?Self.Item;
}

struct Upto :: [It] {
    type Item = int;
    var cur: int,
    end: int,

    mut fn next(): ?int {
        if (this.cur >= this.end) { return null; }
        this.cur = this.cur + 1;
        return this.cur - 1;
    }
}

interface Able {
    type Iter :: [It];
    fn iter(): Self.Iter;
}

extend<I :: [It]> I :: [Able<Iter = I>] {
    fn iter(): I {
        return this;
    }
}

fn count<I :: [It]>(i: I): int {
    var c = i;
    var n = 0;
    while (c.next() != null) { n = n + 1; }
    return n;
}

fn through<A :: [Able]>(a: A): int {
    return count(a.iter());
}

fn main(): int {
    println(f"{through(Upto { cur = 0, end = 3 })}");
    return 0;
}
