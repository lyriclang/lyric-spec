//! check
//! error: LYS-SEM0028
//! since: 1.0.0
// §5 rule 20 (Script 05 Fl): a float hashes not, nor a struct that holds one.
fn hashOf<T :: [Hashable]>(x: T): int {
    let h = Hasher { }
    x.hash(h)
    return h.finish()
}
struct F {
    x: float,
}
let a = hashOf(1.5)
let b = hashOf(F { x = 1.0 })
