//! run
//! stdout:
//! | 7
//! | 7
//! since: 5.0.0
// 05 §5 rule 1: 'Keyed<int>' delegated, its member in the instance's terms, 'fn key(): int'.
import std.io { println };

interface Keyed<K> {
    fn key(): K;
}

struct Inner :: [Keyed<int>] {
    k: int,

    fn key(): int {
        return this.k;
    }
}

struct Outer :: [Keyed<int> by inner] {
    inner: Inner,
}

fn main(): void {
    let o = Outer { inner = Inner { k = 7 } };
    println(f"{o.key()}");
    let k: Keyed<int> = o;
    println(f"{k.key()}");
}
