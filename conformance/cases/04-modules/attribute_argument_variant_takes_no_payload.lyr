//! check
//! error: LYR-SEM0066
//! since: 2.10.0
// §4.7: a row holds one value per field, so a variant that carries a payload is values of its
// own and cannot stand as an attribute argument.
import std.core { OnFunction };

enum Shape {
    Dot,
    Circle(float),
}

struct Tag :: [OnFunction] { shape: Shape }

@Tag { shape = Shape.Circle(1.0) }
pub fn draw(): void { }

fn main(): int {
    return 0;
}
