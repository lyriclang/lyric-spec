// §4 rule 5 (02 V): a module's binding takes a visibility word as a declaration does: without one,
// with `pub` or `internal` it is seen beyond its file; its own module reads and writes a private one.
import lib { next, plain, open, inside }

let a = next()
let b = next()
println(f"{a} {b}")
println(plain + open + inside)
