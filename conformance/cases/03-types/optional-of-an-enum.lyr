//! run
//! stdout:
//! | none green
//! | 0 2
//! since: 5.0.0
// 03 §4.1, §3: an optional of an enum holds a variant or null; '.Green' stands where a '?Signal'
// is expected, and a match on the optional admits null and the variants.
import std.io { println };

enum Signal { Red, Yellow, Green }

fn name(m: ?Signal): string {
    if (m == null) { return "none"; }
    return match (m) { .Red => "red", .Yellow => "yellow", .Green => "green" };
}

fn rank(m: ?Signal): int {
    return match (m) { null => 0, .Red => 1, .Yellow | .Green => 2 };
}

fn main(): int {
    var light: ?Signal = null;
    let before = name(light);
    light = .Green;
    println(before + " " + name(light));
    println(f"{rank(null)} {rank(light)}");
    return 0;
}
