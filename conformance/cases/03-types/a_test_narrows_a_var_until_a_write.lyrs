//! run
//! since: 1.0.0
//! stdout:
//! | 3
//! | 4
//! | 6
// Lyric 5 §3.2: a `var` is narrowed until a write; after it a new test narrows again; a second
// test of a `??int` narrows the `?int` it gave to `int`.
fn f(): int {
    var x: ?int = 3
    if (x != null) {
        let before = x
        println(before)
        x = 4
        if (x != null) {
            return x
        }
    }
    return 0
}
fn g(): int {
    let c: ??int = 5
    if (c != null) {
        if (c != null) {
            return c + 1
        }
    }
    return 0
}
println(f())
println(g())
