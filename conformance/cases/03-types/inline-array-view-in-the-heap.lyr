//! run
//! stdout:
//! | 2 60 80 9
//! since: 5.0.0
// 03 §5.3: a view of an inline array is taken where the array lies in the heap — a field of an
// object, an element of an array — and writes into it.
import std.io { println };

class Buffer { var data: int[4] }

fn total(xs: Slice<int>): int {
    var sum = 0;
    for (i in 0..xs.length()) { sum += xs[i]; }
    return sum;
}

fn main(): int {
    let buf = Buffer { data = [5, 6, 7, 8] };
    let view = buf.data[1..3];
    view[0] = 60;
    let rows: int[4][] = [[1, 2, 3, 4]];
    println(f"{view.length()} {buf.data[1]} {total(buf.data)} {total(rows[0][1..])}");
    return 0;
}
