//! run
//! stdout:
//! | 9 1 3
//! since: 5.0.0
// 03 §2.5: a path reaches into a struct held by value; the inner original is untouched.
import std.io { println };

struct Point { x: int, y: int }
struct Line { from: Point, to: Point }

fn main(): int {
    let line = Line { from = Point { x = 1, y = 2 }, to = Point { x = 3, y = 4 } };
    let bent = line with { to.x = 9 };
    println(f"{bent.to.x} {bent.from.x} {line.to.x}");
    return 0;
}
