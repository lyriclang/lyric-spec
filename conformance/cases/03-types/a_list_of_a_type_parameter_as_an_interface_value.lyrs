//! run
//! stdout:
//! | [1, 2]
//! | true false
//! | [Foo { }]
//! | [Pt { x = 3 }]
//! | true false true
//! | [5] ["s"]
//! since: 1.0.0
// §3 rule 16: a list of a type parameter is an interface value of its copy's element — a shared
// copy's box made at run time —, and `x is T[]` tests it.
class Foo {
}
struct Pt {
    x: int,
}
fn f<T>(xs: T[]): Any = xs
fn isListOf<T>(x: Any): bool = x is T[]
fn one<T>(x: T): Any = [x]
println(f([1, 2]))
let a = f([Foo { }])
println(f"{a is Foo[]} {a is Pt[]}")
println(a)
println(f([Pt { x = 3 }]))
println(f"{isListOf<Foo>(a)} {isListOf<Pt>(a)} {isListOf<int>(f([1]))}")
println(f"{one(5)} {one("s")}")
