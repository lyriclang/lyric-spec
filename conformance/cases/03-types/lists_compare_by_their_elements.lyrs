//! run
//! stdout:
//! | true false true
//! | true true false
//! | 1 null
//! | true 0 true [2, 3]
//! | true [1, 2, 3]
//! | [1, 2, 3, 1]
//! | true false
//! | true
//! since: 1.0.0
// §3 rule 16: where the elements compare — `==`, `in`, `contains`, `indexOf`, `remove`, `dedup`.
struct P {
    a: int,
    tags: string[],
}
let xs = [1, 2, 3]
println(f"{xs == [1, 2, 3]} {xs == [1, 2]} {xs != [3, 2, 1]}")
println(f"{2 in xs} {7 !in xs} {xs.contains(7)}")
println(f"{xs.indexOf(2) ?? -1} {xs.indexOf(7)}")
let first = [1, 2, 3]
let dropped = first.remove(1)
println(f"{xs.contains(1)} {xs.indexOf(1) ?? -1} {dropped} {first}")
let ys = [1, 7, 2, 3]
let had = ys.remove(7)
println(f"{had} {ys}")
let runs = [1, 1, 2, 3, 3, 3, 1]
runs.dedup()
println(runs)
let p = P { a = 1, tags = ["x"] }
let q = P { a = 1, tags = ["x"] }
let r = P { a = 1, tags = ["y"] }
println(f"{p == q} {p == r}")
println([(1, "a"), (2, "b")].contains((2, "b")))
