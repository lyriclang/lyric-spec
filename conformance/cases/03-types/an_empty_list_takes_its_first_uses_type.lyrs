//! run
//! stdout:
//! | ["ann", "bo"]
//! | [1.5]
//! | [1, 4, 9]
//! | 0
//! since: 1.0.0
// §3 rule 8: `var xs = []` and `let xs = []` take the type of the first use that fixes one — a
// push, or the binding where a list is taken.
var names = []
names.push("ann")
names.push("bo")
println(names)
let nums = []
nums.push(1.5)
println(nums)
fn squares(): int[] {
    var out = []
    for (k in 1..=3) {
        out.push(k * k)
    }
    return out
}
println(squares())
fn count(xs: string[]): int = xs.length()
let none = []
println(count(none))
