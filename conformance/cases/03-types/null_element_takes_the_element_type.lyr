//! run
//! exit: 0
//! since: 2.3.1
// §3.1: an array-literal element is a context position, so a 'null' there takes the element
// type rather than standing without one. The counterpart of the adaptation this chapter's
// context case pins for literals.
fn main(): int {
    let xs: (?int)[] = [null, 5];
    let head = xs[0];
    let tail = xs[1] ?? 0;
    return if (head == null && tail == 5) 0 else 1;
}
