//! check
//! since: 1.0.0
//! error: LYS-SEM0003
// Lyric 5 §3.2: a loop that writes a narrowed binding has it narrowed in none of its turns —
// the second turn reads it after the write.
fn f(): int {
    var x: ?int = 3
    var y = 0
    if (x != null) {
        while (y < 2) {
            y = x + 1
            x = null
        }
    }
    return y
}
println(f())
