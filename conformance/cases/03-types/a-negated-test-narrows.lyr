//! run
//! stdout:
//! | 5 0 5 0 | 3 -1 8 5
//! since: 5.0.0
// 03 §3.2 rule 3: a negated test proves what the test refutes - behind a guard that leaves, in
// the branch it guards, in an 'if' expression, in a loop's head; and a negation around '&&'
// follows from the rule for '&&'.
import std.io { println };

fn next(x: ?int): int {
    if (!(x != null)) {
        return 0;
    }
    return x + 1;
}

fn other(x: ?int): int {
    if (!(x == null)) {
        return x + 1;
    }
    return 0;
}

fn sum(a: ?int, b: ?int): int {
    if (!(a != null && b != null)) {
        return -1;
    }
    return a + b;
}

fn twice(x: ?int): int {
    return if (!!(x != null)) x * 2 else 0;
}

fn drain(x: ?int): int {
    var left = x;
    var n = 0;
    while (!(left == null)) {
        n += left;
        left = null;
    }
    return n;
}

fn main(): void {
    println(f"{next(4)} {next(null)} {other(4)} {other(null)} | {sum(1, 2)} {sum(1, null)} {twice(4)} {drain(5)}");
}
