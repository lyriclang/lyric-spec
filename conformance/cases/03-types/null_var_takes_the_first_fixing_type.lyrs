// §3 rule 8: `var x = null` takes the type of the first use that fixes one — in a function and in
// the script's code; uses before it that fix nothing are checked against that type.
fn best(): int {
    var best = null
    var i = 0
    while (i < 5) {
        i += 1
        if (best == null || i * 3 % 5 > best) {
            best = i * 3 % 5
        }
    }
    return best!
}
fn take(x: ?string): int = if (x == null) 1 else 2
fn passed(): int {
    var s = null
    return take(s)
}
var last = null
for (i in 1..4) {
    last = i
}
println(best())
println(last!)
println(passed())
