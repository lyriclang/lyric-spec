//! run
//! stdout:
//! | 2 2 0 20 10
//! since: 5.0.0
// 03 §8.4: 'obj.method' is a closure bound to the object — shared for a class, a copy for a
// struct; 'Type.staticFn' is a function value.
import std.io { println };

class Counter {
    var n: int,
    mut fn bump(): int { this.n += 1; return this.n; }
    fn peek(): int { return this.n; }
    static fn make(): Counter { return Counter { n = 0 }; }
}
struct Acc { var total: int, mut fn add(x: int): int { this.total += x; return this.total; } }

fn main(): int {
    let cnt = Counter.make();
    let bump = cnt.bump;
    bump();
    let bumped = bump();
    let make = Counter.make;
    var acc = Acc { total = 10 };
    let add = acc.add;
    add(5);
    println(f"{bumped} {cnt.peek()} {make().n} {add(5)} {acc.total}");
    return 0;
}
