//! run
//! stdout:
//! | 0 255 1
//! | -128 127
//! | -9223372036854775808
//! since: 5.0.0
// 03 §1.6: +% -% *% wrap at the type's width and never panic.
import std.io { println };

fn addU8(a: uint8, b: uint8): uint8 { return a +% b; }
fn subU8(a: uint8, b: uint8): uint8 { return a -% b; }
fn mulU8(a: uint8, b: uint8): uint8 { return a *% b; }
fn addI8(a: int8, b: int8): int8 { return a +% b; }
fn subI8(a: int8, b: int8): int8 { return a -% b; }
fn add(a: int, b: int): int { return a +% b; }

fn main(): int {
    println(f"{addU8(255, 1)} {subU8(0, 1)} {mulU8(129, 129)}");
    println(f"{addI8(127, 1)} {subI8(-128, 1)}");
    var big = add(9223372036854775807, 0);
    big +%= 1;
    println(f"{big}");
    return 0;
}
