//! check
//! error: LYR-SEM0001
// §3.1: match arms (and if-expression arms, and array elements) are NOT adaptation contexts —
// the arms unify among themselves as 'int' first, and 'int' meets 'int64' as an ordinary
// assignment error.
fn main(): int {
    let m: int64 = match (1) {
        1 => 6,
        _ => 7,
    };
    return 0;
}
