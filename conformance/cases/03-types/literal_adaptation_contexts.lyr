//! run
//! exit: 0
// §3.1: the adaptation contexts, exhaustively — binding initializer, call argument, field
// initializer, return value, parameter default, binary operand ('??' counts). Every position
// below holds an UNSUFFIXED literal meeting an int64 slot.
struct Box {
    v: int64,
}

fn takes(v: int64): int64 {
    return v;
}

fn gives(): int64 {
    return 5;
}

fn withDefault(v: int64 = 9): int64 {
    return v;
}

fn main(): int {
    let a: int64 = 1;
    let b = Box { v = 4 };
    let sum = a + 1;
    let maybe: ?int64 = null;
    let filled = maybe ?? 7;
    let total = sum + b.v + takes(3) + gives() + withDefault() + filled;
    return if (total == 30) 0 else 1;
}
