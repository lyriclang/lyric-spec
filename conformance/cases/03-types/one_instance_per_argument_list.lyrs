//! run
//! stdout:
//! | Pair { a = "x", b = 1 }
//! | Pair { a = 1, b = 1 }
//! since: 1.0.0
// §3 rule 12: each list of arguments is an instance of its own — `Pair<B, A>` and `Pair<A, A>`
// in one generic are two.
struct Pair<A, B> {
    a: A,
    b: B,
    fn swap(): Pair<B, A> = Pair { a = this.b, b = this.a }
    fn twice(): Pair<A, A> = Pair { a = this.a, b = this.a }
}
let p: Pair<int, string> = Pair { a = 1, b = "x" }
println(p.swap())
println(p.twice())
