//! run
//! stdout:
//! | (1, "x") (1, x) true false
//! | true 2 7
//! | (1, (2, 3)) 3
//! since: 5.0.0
// 03 §6.6: a tuple of two to eight elements is Equatable, Hashable, Debug and Display where its
// elements are — floats compare though they do not hash; a tuple is a set's element, a map's key.
import std.io { println };
import std.collections { Map, Set };

fn main(): void {
    let t = (1, "x");
    println(f"{t:?} {t} {t == (1, "x")} {t == (2, "x")}");
    let s = Set<(int, string)>.new();
    s.insert(t);
    s.insert((2, "y"));
    s.insert((1, "x"));
    let m = Map<(int, string), int>.new();
    m.insert((1, "a"), 7);
    println(f"{(1.5, 2) == (1.5, 2)} {s.length()} {m.get((1, "a")) ?? 0}");
    let wide = (1, 2, 3, 4, 5, 6, 7, 8);
    println(f"{(1, (2, 3)):?} {wide.7 - wide.4}");
}
