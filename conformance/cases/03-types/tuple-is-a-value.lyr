//! run
//! stdout:
//! | 5,12 3,4
//! since: 5.0.0
// 03 §6: a tuple in an object is replaced whole; a binding holds its own copy.
import std.io { println };

class Holder { var pos: (x: int, y: int) }

fn main(): int {
    let h = Holder { pos = (3, 4) };
    let kept = h.pos;
    h.pos = (5, 12);
    println(f"{h.pos.x},{h.pos.y} {kept.0},{kept.1}");
    return 0;
}
