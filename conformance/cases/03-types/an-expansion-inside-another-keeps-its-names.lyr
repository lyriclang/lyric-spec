// 03 §8.5 rule 1: one expansion of forEach set in place inside another keeps its own names - the
// outer walks its own range after the inner has walked its.
import std.io { println };

fn main(): void {
    var n = 0;
    (0..3).forEach((a) => {
        (0..4).forEach((b) => { n += a * 10 + b; });
    });
    println(f"{n}");
}
