//! run
//! stdout:
//! | 30 10 99
//! since: 5.0.0
// 03 §5.1: '^n' inside the brackets is the index 'length() - n', read and written.
import std.io { println };

fn main(): int {
    let xs = [10, 20, 30];
    let last = xs[^1];
    let first = xs[^3];
    xs[^2] = 99;
    println(f"{last} {first} {xs[1]}");
    return 0;
}
