//! run
//! stdout:
//! | 8 -1
//! since: 5.0.0
// 03 §3.1, §3.3: a value is wrapped at a return; ?? takes the value or the right side.
import std.io { println };

fn find(n: int): ?int {
    if (n > 0) { return n * 2; }
    return null;
}

fn main(): int {
    println(f"{find(4) ?? -1} {find(0) ?? -1}");
    return 0;
}
