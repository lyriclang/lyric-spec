//! run
//! stdout:
//! | 15 4
//! since: 5.0.0
// 03 §8.3: a class's 'this' is captured as the shared reference; a struct's as a copy.
import std.io { println };

class Scale { var factor: int, fn scaled(): fn(int) -> int { return (n: int): int => n * this.factor; } }
struct Pair { var a: int, fn adder(): fn(int) -> int { return (n: int): int => n + this.a; } }

fn main(): int {
    let scale = Scale { factor = 3 };
    let times = scale.scaled();
    scale.factor = 5;
    var pair = Pair { a = 1 };
    let add = pair.adder();
    pair.a = 100;
    println(f"{times(3)} {add(3)}");
    return 0;
}
