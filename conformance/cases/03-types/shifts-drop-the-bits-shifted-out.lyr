//! run
//! stdout:
//! | 8 -1 -2 128
//! since: 5.0.0
// 03 §1.6: below the width a shift discards what leaves; a signed right shift keeps the sign.
import std.io { println };

fn shl(a: int, b: int): int { return a << b; }
fn shr(a: int, b: int): int { return a >> b; }
fn shl8(a: int8, b: int8): int8 { return a << b; }
fn shlU8(a: uint8, b: uint8): uint8 { return a << b; }

fn main(): int {
    println(f"{shl(1, 3)} {shr(-8, 3)} {shl8(127, 1)} {shlU8(255, 7)}");
    return 0;
}
