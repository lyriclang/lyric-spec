//! run
//! stdout:
//! | 4 none 6
//! since: 5.0.0
// 03 §8.1: a function value is held in a field, an optional and an array, and called from there.
import std.io { println };

class Holder { var op: fn(int) -> int }

fn twice(x: int): int { return x * 2; }
fn maybe(flag: bool): ?fn(int) -> int { return if (flag) twice else null; }

fn main(): int {
    let some = maybe(true);
    let none = maybe(false);
    let h = Holder { op = (x: int): int => x + 1 };
    let ops = [twice, h.op];
    println(f"{(some ?? twice)(2)} " + (if (none == null) "none" else "some") + f" {ops[1](ops[0](2)) + 1}");
    return 0;
}
