//! run
//! stdout:
//! | 12 30 4 4 geo
//! since: 5.0.0
// 15 §5 rules 17–18: the header's struct, enum, function pointer, variadic function and
// constants, written for the target and imported as a module of the package.
import std.io { println };
import app.geo { Size, Kind, GEO_LARGE, GEO_SCALE, GEO_NAME, geo_area, geo_apply, geo_count };

fn triple(value: int32): int32 {
    return value * 3;
}

fn main(): void {
    let kind: Kind = GEO_LARGE;
    println(f"{geo_area(Size { w = 3, h = 4 })} {geo_apply(triple, GEO_SCALE)} {kind} {geo_count("abcd", 1)} {GEO_NAME}");
}
