#!/usr/bin/env lyric-script
---
[dependencies]
geo = { git = "{repos}/geo", tag = "v1.0.0" }
units = { path = "deps/units" }
---
import geo { area }
import units { unit }
import helper { twice }

println(twice(area(3) + unit()))

