//! check
//! error: LYR-SEM0186
//! since: 5.0.0
// 11 §5 rule 9: a macro whose first parameter is a declaration sits on one, so its result is a
// declaration or several — not an expression.
import std.syntax { Expr, FnDecl };

macro Wrong(target: FnDecl): Expr {
    return quote { 1 };
}

fn main(): void { }
