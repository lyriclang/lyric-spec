//! run
//! stdout:
//! | 6 36
//! since: 5.0.0
// 11 §2 rule 6: 'comptime { … }' is a block evaluated whole, its last expression the value; it
// binds, assigns, loops and builds lambdas as any block does.
import std.io { println };

fn main(): void {
    let x = comptime {
        let a = 3;
        a * 2
    };
    let s = comptime {
        let xs = [1, 2, 3];
        var t = 0;
        for (v in xs) {
            t += v;
        }
        let times = (v: int) => v * t;
        times(xs[0]) + times(xs[1]) + times(xs[2])
    };
    println(f"{x} {s}");
}
