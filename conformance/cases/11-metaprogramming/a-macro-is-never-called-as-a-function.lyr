//! check
//! error: LYR-SEM0187
//! since: 5.0.0
// 11 §5 rule 1: a macro is never called as a function and never a value — its name stands at a
// site, with the `!`.
import std.io { println };
import std.syntax { Expr };

macro same(e: Expr): Expr {
    return e;
}

fn main(): void {
    println(same(3));
}
