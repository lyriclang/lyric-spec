//! run
//! since: 1.0.0
//! stdout:
//! | 0 3 7
//! | 11
//! | 1 3
//! | a[] b[1, 2] c[]
//! | 6 1
//! | 9
// §8 rule 6 (Lyric 5 §8 §1.1 rule 1): a variadic parameter takes the remaining positional
// arguments as an array, the empty one where there are none; `xs...` spreads an array over it, so
// one variadic function hands its arguments on; each argument is one element — `[1, 2]` too where
// the element type takes it; a function value of a variadic function takes the array.
fn sum(xs: int...): int {
    var t = 0
    for (x in xs) {
        t += x
    }
    return t
}
fn count<T>(xs: T...): int = xs.length()
fn tagged(tag: string, xs: int...): string = f"{tag}{xs}"
struct P {
    n: int
    fn add(xs: int...): int {
        var t = this.n
        for (x in xs) {
            t += x
        }
        return t
    }
}
fn logged(xs: int...): int = sum(xs...)

println(f"{sum()} {sum(1, 2)} {sum([3, 4]...)}")
let f = sum
println(f([5, 6]))
println(f"{count([1, 2])} {count(1, 2, 3)}")
println(f"{tagged("a")} {tagged("b", 1, 2)} {tagged(tag: "c")}")
let p = P { n = 1 }
println(f"{p.add(2, 3)} {p.add()}")
println(logged(4, 5))
