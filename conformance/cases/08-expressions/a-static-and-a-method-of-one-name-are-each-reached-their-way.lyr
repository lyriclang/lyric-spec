//! run
//! stdout:
//! | 1 3
//! | 5 3
//! since: 5.0.0
// 08 §1.2 rule 1: a method and a static of one name share the type's scope; a value reaches the
// methods, the type the statics, and the count chooses — whichever is declared first.
import std.io { println };

struct W {
    static fn m(a: int, b: int): int { return a + b; }
    fn m(a: int): int { return a; }
}

fn main(): void {
    let w = W { };
    println(f"{w.m(1)} {W.m(1, 2)}");
    let h = w.m;
    let s = W.m;
    println(f"{h(5)} {s(1, 2)}");
}
