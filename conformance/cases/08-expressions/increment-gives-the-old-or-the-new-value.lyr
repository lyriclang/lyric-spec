//! run
//! stdout:
//! | 5 7 7 6
//! | 3 1
//! since: 5.0.0
// 08 §6: 'x++' is worth the old value, '++x' the new one — on a local, a field and an element
// alike.
import std.io { println };

class Counter {
    var count: int = 0,
}

fn main(): void {
    var i = 5;
    let a = i++;
    let b = ++i;
    let c = i--;
    let k = Counter { };
    k.count++;
    ++k.count;
    var xs = [0, 0];
    xs[1]++;
    println(f"{a} {b} {c} {i}");
    println(f"{k.count + 1} {xs[1]}");
}
