//! check
//! error: LYR-SEM0001
//! since: 5.0.0
// 08 §1.1 rule 1: an array handed to a variadic parameter is one argument - 'sum(xs)' gives
// 'int...' an 'int[]' where it takes 'int' values; 'sum(xs...)' is what hands it on.
fn sum(xs: int...): int {
    var s = 0;
    for (x in xs) { s = s + x; }
    return s;
}

fn main(): int {
    let xs = [1, 2, 3];
    return sum(xs);
}
