//! run
//! stdout:
//! | 1 3
//! | a z
//! | 3
//! since: 5.0.0
// 08 §1.2 rule 1: a block on a shape is a scope like a type's, its members of one name a set the
// count chooses from, called and named.
import std.io { println };

extend<T> T[] {
    fn pick(a: int): int { return a; }
    fn pick(a: int, b: int): int { return a + b; }
    fn firstOr(): T { return this[0]; }
    fn firstOr(d: T): T { return if (this.length() > 0) this[0] else d; }
}

fn main(): void {
    let xs = [1];
    println(f"{xs.pick(1)} {xs.pick(1, 2)}");
    let words = ["a"];
    let none: string[] = [];
    println(f"{words.firstOr()} {none.firstOr("z")}");
    let h: fn(int, int) -> int = xs.pick;
    println(h(1, 2));
}
