//! run
//! stdout:
//! | 10
//! | [10, 25, 30]
//! | [10, 75, 30]
//! | 1
//! | [(1, "a"), (7, "z")]
//! since: 1.0.0
// §8 rule 3: `xs[i]` reads, `xs[i] = v` writes, `xs[i] op= v` evaluates the list and the index
// once.
class Count {
    var n: int = 0
}
let calls = Count { }
fn at(k: int): int {
    calls.n += 1
    return k
}
let xs = [10, 20, 30]
println(xs[0])
xs[1] = 25
println(xs)
xs[at(1)] *= 3
println(xs)
println(calls.n)
let pairs = [(1, "a"), (2, "b")]
pairs[1] = (7, "z")
println(pairs)
