//! run
//! stdout:
//! | 1 2 3 5 8
//! | 21 11
//! | 12
//! | callback 0
//! | other 0
//! | callback 1
//! | other 1
//! since: 5.0.0
// 13 §3 rule 9: C calls a Lyric function through its pointer - one named, through qsort and C's own
// call, a lambda that captures nothing -; Lyric calls a pointer C returned; a callback parks with
// C's frames below it while another task runs.
import std.io { println };
import std.ffi { Ptr };
import std.task { spawn, yieldNow };

extern "C" {
    fn qsort(base: Ptr<int>, count: uint, size: uint, compare: extern "C" fn(Ptr<int>, Ptr<int>) -> int32): void;
    fn apply(f: extern "C" fn(int) -> int, x: int): int;
    fn each(f: extern "C" fn(int) -> void, n: int): void;
    fn c_triple(): extern "C" fn(int) -> int;
}

fn ascending(a: Ptr<int>, b: Ptr<int>): int32 {
    var order: int32 = 0;
    unsafe {
        let x = a.read();
        let y = b.read();
        order = if (x < y) -1 else if (x > y) 1 else 0;
    }
    return order;
}

fn plusTen(x: int): int {
    return x + 10;
}

fn step(i: int): void {
    println(f"callback {i}");
    try! yieldNow();
}

fn main(): void throws Error {
    let xs = [5, 3, 8, 1, 2];
    qsort(xs.asPtr(), 5, 8, ascending);
    println(f"{xs[0]} {xs[1]} {xs[2]} {xs[3]} {xs[4]}");
    println(f"{apply(plusTen, 1)} {apply((x) => x * 2 + 1, 2)}");
    let triple = c_triple();
    println(f"{triple(4)}");
    let other = spawn(() => {
        for (i in 0..2) {
            println(f"other {i}");
            try yieldNow();
        }
    });
    each(step, 2);
    try other.await();
}
