//! run
//! stdout:
//! | 5 2.5 true
//! since: 5.0.0
// 15 §5 rule 1, 13 §2 rules 1-3: a package's C, called through extern "C".
import std.io { println };

extern "C" fn add(a: int, b: int): int;
extern "C" fn half(x: float): float = "lyric_half";
extern "C" fn even(n: int): bool;

fn main(): void {
    println(f"{add(2, 3)} {half(5.0)} {even(4)}");
}
