//! run
//! exit: 0
fn main(): int {
    // Spec 1.3: decimal, hex, binary, octal, with separators and either prefix case.
    let d = 1_000;
    let h = 0xFF;
    let b = 0b1010;
    let o = 0o52;
    let s = 42i8;
    if (h == 255 && b == 10 && o == 42 && d == 1000 && s as int == 42) {
        return 0;
    }
    return 1;
}
