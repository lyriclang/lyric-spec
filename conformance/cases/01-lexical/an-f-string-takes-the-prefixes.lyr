//! run
//! stdout:
//! | 7\t{}
//! | n = 7
//! |   8
//! | done
//! since: 5.0.0
// 01 §4.6: 'fr"…"' resolves no escape, braces still fold; 'f"""…"""' runs over lines, a line that
// begins with a hole indented as any other.
import std.io { println };

fn main(): void {
    let n = 7;
    println(fr"{n}\t{{}}");
    println(f"""
        n = {n}
          {n + 1}
        done
        """);
}
