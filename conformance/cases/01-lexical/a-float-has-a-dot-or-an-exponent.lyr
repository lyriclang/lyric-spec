//! run
//! stdout:
//! | 1.0 2500.0 0.01 1000.5 1.5
//! since: 5.0.0
// 01 §4.2: a '.' between digits, an exponent with its sign, '_', a suffix.
import std.io { println };

fn main(): void {
    let a = 1.0;
    let b = 2.5e3;
    let c = 1e-2;
    let d = 1_000.5;
    let e = 1.5f32;
    println(f"{a} {b} {c} {d} {e}");
}
