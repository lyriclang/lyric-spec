//! run
//! env: LYRIC_SCRIPT_RIGHTS=files=file,web=net
//! exit: 2
//! stderr-has: error[LYS-CAP0001]: the right 'file' was not given: import files
//! stderr-has: error[LYS-CAP0001]: the right 'net' was not given: import web
//! since: 1.0.0
// §17 rule 1 (01 S1, S4): a module of a class of rights asks for it where it is imported;
// nothing is given unless the run gives it, and without a terminal every missing right is
// reported at once, with its import, before anything runs: exit 2.
import files { read }
import web { get }

println(read() + get())
