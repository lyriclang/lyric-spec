//! check
//! clean: generator-copies-this
//! since: 5.0.0
// 16 §5: 'generator-copies-this' says nothing where the program is put right.
class Counter {
    var n: int,

    mut fn count(): Coroutine<int> {
        this.n += 1;
        yield this.n;
    }
}

fn main(): void {
    let c = Counter { n = 0 };
    for (x in c.count()) { assert(x == 1); }
}
