//! check
//! clean: large-value-copy
//! since: 5.0.0
// 16 §5: 'large-value-copy' says nothing where the program is put right.
struct Frame {
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int,
}

@Warn("large-value-copy")
fn total(frame: Frame): int {
    return frame.a + frame.h;
}

fn main(): void {
    let _ = total(Frame { a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8 });
}
