//! run
//! stdout:
//! | none
//! | 2
//! since: 5.0.0
// 06 §8.5: the parenthesized form writes the lambda's set after its return type.
import std.io { println };

class Negative :: [Error] { fn message(): string { return "negative"; } }

fn check(n: int): int throws Negative {
    if (n < 0) { throw Negative { }; }
    return n;
}

fn main(): void {
    let g = (n: int): int throws Negative => try check(n);
    let v = try? g(-1);
    if (v == null) { println("none"); }
    let w = try! g(2);
    println(f"{w}");
}
