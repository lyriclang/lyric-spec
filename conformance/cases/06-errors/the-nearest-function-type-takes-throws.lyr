//! run
//! stdout:
//! | made
//! | caught negative
//! since: 5.0.0
// 06 §8.1: the 'throws' after a returned function type is that type's, not the function's -
// 'make' throws nothing, the function it returns does.
import std.io { println };

class Negative :: [Error] { fn message(): string { return "negative"; } }

fn fail(): int throws Negative { throw Negative { }; }

fn make(): fn() -> int throws Negative {
    println("made");
    return fail;
}

fn main(): void {
    let f = make();
    try { println(f"{f()}"); } catch (e: Negative) { println(f"caught {e.message()}"); }
}
