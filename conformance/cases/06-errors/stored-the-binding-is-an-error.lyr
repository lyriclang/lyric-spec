//! check
//! error: LYR-SEM0034
//! since: 5.0.0
// 06 §4.6: the set is the binding's alone - stored in another name the value is an 'Error', and
// that is what throwing it throws.
enum NotFound :: [Error] { Gone; fn message(): string { return "gone"; } }
enum Parse :: [Error] { Bad; fn message(): string { return "bad"; } }
fn both(): int throws [NotFound, Parse] { return 1; }
fn pass(): int throws Parse {
    try { return both(); }
    catch (_: NotFound) { return 0; }
    catch (e) { let kept = e; throw kept; }
}
fn main(): int { return 0; }
