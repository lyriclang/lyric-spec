//! run
//! stdout:
//! | body
//! | close b
//! | defer between
//! | close a
//! since: 5.0.0
// 06 §7.1: 'using let' closes what it binds when the scope is left, in the scope's one LIFO list
// with its defers.
import std.io { println };

class Res :: [Closeable] {
    name: string,
    failing: bool = false,

    fn close(): void throws Exception {
        println(f"close {this.name}");
        if (this.failing) { throw Exception { text = f"close {this.name} failed" }; }
    }
}

fn open(name: string): Res { return Res { name = name }; }
fn openFailing(name: string): Res { return Res { name = name, failing = true }; }

fn main(): void throws Exception {
    using let a = open("a");
    defer println("defer between");
    using let b = open("b");
    println("body");
}
