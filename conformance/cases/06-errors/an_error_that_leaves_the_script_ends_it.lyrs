//! run
//! since: 1.0.0
//! exit: 1
//! stdout:
//! | before
//! stderr:
//! | error: config
//! |   caused by: disk
// §6 rule 4 (Lyric 5 §5 rule 3, Script 05 E6): an error that leaves the script's code ends the run
// with exit code 1: `error:` with its message, a line for each cause, then its frames.
fn load() {
    throw Exception("disk")
}
fn configure() {
    try {
        load()
    } catch (e) {
        throw Exception("config", cause: e)
    }
}
println("before")
configure()
println("never")
