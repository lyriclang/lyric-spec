//! check
//! error: LYS-SEM0034
//! since: 1.0.0

// §6 rule 5: what the call's type throws is not covered by another error
struct E1 :: Error {
    fn message(): string = "e1"
}
struct E2 :: Error {
    fn message(): string = "e2"
}
interface Src {
    fn read(): int
}
struct B :: Src {
    fn read(): int throws E1 {
        throw E1 { }
    }
}

fn go<T :: [Src]>(t: T): int = t.read()
fn wrong(): int throws E2 = go(B { })
