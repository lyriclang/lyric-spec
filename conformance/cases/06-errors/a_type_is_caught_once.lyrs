//! check
//! since: 1.0.0
//! error: LYS-SEM0141
// §6 rule 9 (Lyric 5 §4 rule 5): a `try` catches a type once.
struct A :: Error {
    fn message(): string = "a"
}
struct B :: Error {
    fn message(): string = "b"
}
fn f(n: int): int {
    if (n == 1) {
        throw A { }
    }
    if (n == 2) {
        throw B { }
    }
    return n
}
try {
    println(f(1))
} catch (_: A) {
    println("a")
} catch (_: A) {
    println("again")
}
