//! run
//! stdout:
//! | 4
//! | A
//! | B
//! since: 5.0.0
// 06 §8 rule 6: an argument that throws several types binds 'E' to their set, so the call throws
// each of them, and a set naming the two covers it.
import std.io { println };

class A :: [Error] { fn message(): string { return "a"; } }
class B :: [Error] { fn message(): string { return "b"; } }

fn both(n: int): int throws [A, B] {
    if (n < 0) { throw A { }; }
    if (n > 9) { throw B { }; }
    return n;
}

fn twice<T, E :: [Error]>(x: T, f: fn(T) -> T throws E): T throws E {
    let y = try f(x);
    return try f(y);
}

fn run(n: int): int throws [A, B] {
    return try twice(n, (m: int): int => try both(m) * 2);
}

fn main(): void {
    for (n in [1, -1, 5]) {
        try {
            println(run(n));
        } catch (_: A) {
            println("A");
        } catch (_: B) {
            println("B");
        }
    }
}
