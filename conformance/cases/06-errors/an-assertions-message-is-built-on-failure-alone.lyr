//! run
//! panic: LYR-RT0011
//! stdout:
//! | built 0
//! stderr:
//! | panic [LYR-RT0011]: assertion failed: n > 2: n = 1
//! since: 5.0.0
// 06 §9 rule 1: the message of 'assert' is a lambda, 'assert(c) { f"..." }', built only when the
// assertion fails - an assertion that holds builds nothing.
import std.io { println };

var built = 0;

fn text(n: int): string {
    built += 1;
    return f"n = {n}";
}

fn main(): void {
    let n = 1;
    assert(n < 2) { text(n) };
    assert(n < 2);
    println(f"built {built}");
    assert(n > 2) { text(n) };
}
