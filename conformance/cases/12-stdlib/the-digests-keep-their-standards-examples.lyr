// 12 §Cryptography, rule 2: SHA-256, SHA-512, SHA-1 and MD5 of "abc" — FIPS 180-4's and RFC
// 1321's example —, and the one-liner.
import std.crypto { Digest, Md5, Sha1, Sha256, Sha512, sha256 };
import std.encoding { Hex };
import std.io { println, ByteBuffer };

fn utf8(s: string): uint8[] {
    let b = ByteBuffer.new();
    try! b.writeString(s);
    return b.toArray();
}

fn hex<D :: [Digest]>(s: string): string {
    var d = D.new();
    d.update(utf8(s)[..]);
    return Hex.encode(d.finish()[..]);
}

fn main(): void {
    println(hex<Sha256>("abc"));
    println(hex<Sha512>("abc"));
    println(hex<Sha1>("abc"));
    println(hex<Md5>("abc"));
    println(Hex.encode(sha256(utf8("abc")[..]).toArray()[..]));
}
