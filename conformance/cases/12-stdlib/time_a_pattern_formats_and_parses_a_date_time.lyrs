//! run
//! option: --allow=os
//! stdout:
//! | 2026-03-29 03:30:00
//! | Sun, 29 Mar 2026 3:30 AM
//! | Sunday March 29, 26 | 03:30:00.000 +0200
//! | +02 +0200 +02:00 +02 +0200 +02:00 | Z Z Z +00 +0000 +00:00
//! | at 03h '
//! | the pattern letter 'Q' is none of y M d H h m s S a E Z X x
//! | 2026-03-29T03:30:00+02:00 2026-03-29T03:30:00+02:00 2026-03-05T00:00:00Z 1970-01-01T23:05:00Z
//! | refused
//! | 5 of 5
//! since: 1.0.0

// §12 rule 32: UTS #35's fields written and read back (Lyric 5 12 §Time, the zones, rule 3), the quotes, a
// letter that is none, the zone resolving a text without an offset, five round trips — Lyric 5's case
import std.time { Date, DateTime, Time, TimeError, Zone }

let cet = Zone.fromPosix("CET", "CET-1CEST,M3.5.0,M10.5.0/3")
let dt = DateTime.of(Date.of(2026, 3, 29), Time.of(3, 30, 0), cet)
let utc = dt.withZone(Zone.utc)
println(dt.format("yyyy-MM-dd HH:mm:ss"))
println(dt.format("EEE, d MMM yyyy h:mm a"))
let long = dt.format("EEEE MMMM d, yy")
let fraction = dt.format("HH:mm:ss.SSS Z")
println(f"{long} | {fraction}")
let offsets = "X XX XXX x xx xxx"
println(f"{dt.format(offsets)} | {utc.format(offsets)}")
println(dt.format("'at' HH'h' ''"))
try {
    let _ = dt.format("Q")
} catch (e: TimeError) {
    println(e.message())
}
let a = DateTime.parseWith("yyyy-MM-dd HH:mm Z", "2026-03-29 03:30 +0200")
let b = DateTime.parseWith("yyyy-MM-dd HH:mm", "2026-03-29 02:30", cet)
let c = DateTime.parseWith("d MMM yyyy", "5 mar 2026")
let d = DateTime.parseWith("h:mm a", "11:05 pm")
println(f"{a} {b} {c} {d}")
try {
    let _ = DateTime.parseWith("yyyy-MM-dd", "2026/03/29")
    println("accepted")
} catch (_: ParseError) {
    println("refused")
}
var ok = 0
let patterns = [
    "yyyy-MM-dd HH:mm:ss Z",
    "EEE, d MMM yyyy h:mm:ss a XXX",
    "yyyy-MM-dd'T'HH:mm:ss.SSSxxx",
    "d MMMM yyyy HH:mm ZZZZZ",
    "yy/M/d H:m:s x",
]
for (p in patterns) {
    if (DateTime.parseWith(p, dt.format(p)) == dt) {
        ok += 1
    }
}
println(f"{ok} of 5")
