//! run
//! stdout:
//! | true false [1, 2] ["q"] []
//! | true [1, 2] [1, 2]
//! | true false {"k"} {}
//! | true false false {"a": 1} {}
//! | [1, 3, 2]
//! since: 5.0.0
// 12 §Collections (M8a S14, 10 C9): a list and a deque compare in order, a set and a map in any
// order — a map's values too —; each prints its debug text, the same with '?' or without. A heap
// prints its values in its own order: here the one three pushes leave.
import std.io { println };
import std.collections { List, Deque, Set, Map, Heap };

fn main(): void {
    let xs = List<int>.of([1, 2]);
    let ys = List<int>.of([1, 2]);
    let zs = List<int>.of([2, 1]);
    println(f"{xs == ys} {xs == zs} {xs} {List<string>.of(["q"])} {List<int>.new()}");
    let d = Deque<int>.new();
    d.pushBack(2);
    d.pushFront(1);
    let e = Deque<int>.new();
    e.pushBack(1);
    e.pushBack(2);
    println(f"{d == e} {d} {d:?}");
    let s = Set<string>.new();
    s.insert("k");
    let t = Set<string>.new();
    t.insert("k");
    let u = Set<string>.new();
    u.insert("j");
    println(f"{s == t} {s == u} {s} {Set<int>.new()}");
    let m = Map<string, int>.new();
    m.insert("a", 1);
    let n = Map<string, int>.new();
    n.insert("a", 1);
    let o = Map<string, int>.new();
    o.insert("a", 2);
    let p = Map<string, int>.new();
    p.insert("b", 1);
    println(f"{m == n} {m == o} {m == p} {m} {Map<int, int>.new()}");
    let h = Heap<int>.new();
    h.push(3);
    h.push(1);
    h.push(2);
    println(f"{h:?}");
}
