//! run
//! option: -A
//! in-temp-dir
//! stdout:
//! | true
//! | set
//! | inherited
//! since: 1.0.0

// §12 rule 27: `cwd` is the child's working directory; `env` is set over the parent's environment
import std.fs { absolute, createDir }
import std.fs { writeText }
import std.os
import std.process { Command, Stdio }

// the binary under test, the runner names it: the child is a script
let me = os.env("LYRIC_SCRIPT_UNDER_TEST") ?? "lyric-script"
createDir("sub")
writeText("child.lyrs", "import std.os\nprintln(os.cwd().endsWith(\"sub\"))\nprintln(os.env(\"LYRIC_CASE_CHILD\") ?? \"none\")\nprintln(os.env(\"LYRIC_CASE_PARENT\") ?? \"none\")\n")
os.setEnv("LYRIC_CASE_PARENT", "inherited")
let path = absolute("child.lyrs")
let done = Command { program = me, args = ["run", "-A", path], cwd = "sub", env = [("LYRIC_CASE_CHILD", "set")] }.output()
print(string.fromUtf8(done.stdout))
