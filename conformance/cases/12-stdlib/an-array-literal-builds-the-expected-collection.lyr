//! run
//! stdout:
//! | 2 3 [1, 2, 3] 5 2
//! | 0 0 2
//! since: 5.0.0
// 12 §Collections: an array literal where a collection is expected is that collection — a set
// keeps a value once, a map a key's later value; [] takes the element; through an optional too.
import std.collections { Deque, Heap, List, Map, Set };
import std.io { println };

fn main(): void {
    let s: Set<int> = [3, 1, 3];
    let m: Map<string, int> = [("a", 1), ("b", 2), ("a", 3)];
    let l: List<int> = [1, 2, 3];
    let d: Deque<int> = [5, 6];
    let h: Heap<int> = [4, 2, 9];
    let a = "a";
    println(f"{s.length()} {m[a]!} {l.toArray()} {d.popFront()!} {h.pop()!}");
    let none: Set<string> = [];
    let empty: Map<int, int> = [];
    let maybe: ?Set<int> = [1, 2, 2];
    println(f"{none.length()} {empty.length()} {maybe!.length()}");
}
