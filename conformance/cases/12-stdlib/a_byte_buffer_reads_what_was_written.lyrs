// §12 rule 19: appended at the back, read from the front.
import std.io { ByteBuffer }
let b = ByteBuffer.new()
println(b.write(b"abc"))
b.writeString("de")
println(b.length())
let two = Bytes.zeroed(2)
println(b.read(two))
println(two)
println(b.length())
println(b.toBytes())
println(b.readToString())
println(b.read(two))
println(b.length())
