// §12 rule 17: a slice in every form of a range, `^n` among its bounds, is a new `Bytes`
let b = b"hello"
let s = b[1..3]
s[0] = 0
println(b)
println(s)
println(b[..2])
println(b[3..])
println(b[1..=2])
println(b[^2..])
println(b[..^1])
println(b[^3..^1])
println(b[..])
println(b[5..])
println(b[^1])
println(b[^5])
