//! run
//! stdout:
//! | 0.13 -0.13 3 -3 1 2.67 9.99 1.3e+00 1.0e+01 13% 0.2%
//! since: 5.0.0
// 12 §2 rule 3 (the review's M8a-8): a precision rounds half away from zero on the value's exact
// binary digits — the language's one rounding rule, round()'s — the same on every host. 0.125
// and 2.5 are exact halves; the doubles nearest 2.675 and 9.995 lie below theirs. A percentage
// moves the point on the exact digits: 0.0015 a hundredfold is above the half (multiplied as a
// double it would fall below).
import std.io { println };

fn main(): int {
    println(f"{0.125:.2f} {-0.125:.2f} {2.5:.0f} {-2.5:.0f} {0.5:.0f} {2.675:.2f} {9.995:.2f} {1.25:.1e} {9.96:.1e} {0.125:.0%} {0.0015:.1%}");
    return 0;
}
