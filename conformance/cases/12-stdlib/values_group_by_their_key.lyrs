//! run
//! stdout:
//! | {1: [1, 4, 7], 2: [2, 5], 0: [3, 6]}
//! | {}
//! since: 1.0.0
// §12 rule 6 (Lyric 5 12 §Collections): `groupBy(key)` gathers an iterator's values into a map
// from each key, in the order the keys came, to its values, in their order — a program that
// names only it gets the module.
println([1, 2, 3, 4, 5, 6, 7].iter().groupBy((n) => n % 3))
let none: int[] = []
println(none.iter().groupBy((n) => n > 0))
