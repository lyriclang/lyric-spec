//! run
//! stdout:
//! | [20, 40, 60]
//! | [2, 3, 4] [0, 3, 6, 9] [1, 2] [3, 10, 1] 1 null null
//! | [(0, "a"), (1, "b")] [(1, "x"), (2, "y")] [1, 2, 3, 4]
//! | 12 [1, 2] [200, 400] [0, 0, 1, 0, 1, 2] [1, 2, 3]
//! | [1, 2, 1, 3] [1, 2, 5] [0, 1, 3, 6] [3, 2, 1] [9, 4, 1, 0]
//! | 5 5 5 6 null null
//! since: 1.0.0
// §12 rule 3 (Lyric 5 12 Iteration): the adapters of every iterator, lazy, without an import.
let xs: int[] = [1, 2, 3, 4, 5, 6].iter().filter((x) => x % 2 == 0).map((x) => x * 10).collect()
println(xs)
let a: int[] = (0..10).iter().skip(2).take(3).collect()
let b: int[] = (0..10).iter().stepBy(3).collect()
let c: int[] = [1, 2, 3, 10, 1].iter().takeWhile((x) => x < 3).collect()
let d: int[] = [1, 2, 3, 10, 1].iter().skipWhile((x) => x < 3).collect()
let tw = [1, 5, 1].iter().takeWhile((x) => x < 3)
println(f"{a} {b} {c} {d} {tw.next()} {tw.next()} {tw.next()}")
let e: (int, string)[] = ["a", "b"].iter().enumerate().collect()
let z: (int, string)[] = [1, 2, 3].iter().zip(["x", "y"]).collect()
let ch: int[] = [1, 2].iter().chain([3, 4].iter()).collect()
println(f"{e} {z} {ch}")
var seen = ""
let ins: int[] = [1, 2].iter().inspect((x) => { seen += f"{x}" }).collect()
let mnn: int[] = [1, 2, 3, 4].iter().mapNotNull((x) => if (x % 2 == 0) x * 100 else null).collect()
let fm: int[] = [1, 2, 3].iter().flatMap((x) => 0..x).collect()
let fl: int[] = [[1], [2, 3]].iter().flatten().collect()
println(f"{seen} {ins} {mnn} {fm} {fl}")
let dd: int[] = [1, 1, 2, 2, 2, 1, 3, 3].iter().dedup().collect()
let db: int[] = [1, 3, 2, 4, 5].iter().dedupBy((x, y) => x % 2 == y % 2).collect()
let sc: int[] = [1, 2, 3].iter().scan(0, (acc, x) => acc + x).collect()
let rv: int[] = [1, 2, 3].iter().rev().collect()
let rr: int[] = (0..4).iter().rev().map((x) => x * x).collect()
println(f"{dd} {db} {sc} {rv} {rr}")
let pk = [5, 6].iter().peekable()
println(f"{pk.peek()} {pk.peek()} {pk.next()} {pk.next()} {pk.peek()} {pk.next()}")
