// §12 rule 16: a `Signed`, a `TotalOrder`, a `Hashable`, a `Clone`, a `Default`: `std.math`'s functions and
// `std.iter`'s take it, a list sorts it, a map keys it; a struct that holds it compares through its
// `equals`. No `Integer`: that one is a fixed width.
import std.math { BigInt, abs, signum, max, min }
let huge = BigInt.parse("1000000000000000000000000000000")
println(abs(-huge))
println(signum(-huge))
let three: BigInt = 3
println(three.clamp(1, 5))
let two64 = BigInt.parse("18446744073709551616")
println(max(BigInt.from(2).pow(64), two64))
println(min(two64, two64 * BigInt.from(2)))
println(BigInt.from(11).clamp(0, 10))
let xs: BigInt[] = [1, 2, 3]
println(xs.iter().sum())
println(xs.iter().product())
let ys: BigInt[] = [two64, -1, 2]
println(ys.iter().sorted())
let m = Map<BigInt, string>.new()
m.insert(two64, "two to the 64")
println(m.get(BigInt.from(2).pow(64)))
let s = Set<BigInt>.new()
s.insert(BigInt.from(2).pow(64))
println(s.contains(two64))
s.insert(1)
s.insert(two64)
println(s.length())
struct P {
    v: BigInt
    w: int
}
let p = P { v = 5, w = 1 }
println(p)
println(p == P { v = 5, w = 1 })
println(p == P { v = 6, w = 1 })
println(BigInt.default())
println(BigInt.one)
println(huge.clone() == huge)
println(BigInt.zero.isZero())
fn total<T :: [Num]>(a: T[]): T {
    var out = T.zero
    for (x in a) {
        out = out + x
    }
    return out
}
let none: BigInt[] = []
println(total(none))
let forty: BigInt[] = [40, 2]
println(total(forty))
