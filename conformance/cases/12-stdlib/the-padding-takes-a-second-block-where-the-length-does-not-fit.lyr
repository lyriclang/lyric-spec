// 12 §Cryptography, rule 2: the padding and the length fit into the last block at 55 bytes of 64
// (111 of 128) and take a second one from 56 (112).
import std.crypto { Digest, Md5, Sha256, Sha512 };
import std.encoding { Hex };
import std.io { println, ByteBuffer };

fn utf8(s: string): uint8[] {
    let b = ByteBuffer.new();
    try! b.writeString(s);
    return b.toArray();
}

fn hex<D :: [Digest]>(s: string): string {
    var d = D.new();
    d.update(utf8(s)[..]);
    return Hex.encode(d.finish()[..]);
}

fn main(): void {
    println(hex<Sha256>("a" * 55));
    println(hex<Sha256>("a" * 56));
    println(hex<Sha512>("a" * 111));
    println(hex<Sha512>("a" * 112));
    println(hex<Md5>("a" * 56));
}
