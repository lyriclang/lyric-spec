//! run
//! stdout:
//! | ([4], [3, 1, 1, 5]) [[1, 2, 3], [4, 5, 6], [7]] [[1, 2], [2, 3], [3, 4]] []
//! since: 1.0.0
// §12 rule 4: `partition`, `chunks` — the last shorter —, `windows` — none where there are fewer.
let xs = [3, 1, 4, 1, 5]
println(f"{xs.iter().partition((x) => x % 2 == 0)} {(1..=7).iter().chunks(3)} {(1..=4).iter().windows(2)} {(1..=2).iter().windows(3)}")
