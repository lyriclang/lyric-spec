// §12 rule 17: UTF-8 there and back
let s = "hé😀"
let b = s.toBytes()
println(b.length())
println(b)
println(string.fromUtf8(b))
println(string.fromUtf8(b) == s)
println(string.fromUtf8Lossy(b) == s)
b[0] = 72
println(string.fromUtf8(b))
println(s)
println("".toBytes())
println(string.fromUtf8(b"").length())
