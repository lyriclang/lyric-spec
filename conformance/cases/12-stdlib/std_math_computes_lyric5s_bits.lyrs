// §12 rule 14 (Lyric 5 12 §Numbers, `std.math`): the same bits as a compiled program: this text is
// what Lyric 5 prints for the same calls.
import std.math
println(f"{math.floor(-1.5)} {math.ceil(-1.5)} {math.round(2.5)} {math.round(-2.5)} {math.trunc(-1.7)}")
println(f"{math.sqrt(2.0)} {math.cbrt(27.0)} {math.exp(1.0)} {math.ln(10.0)} {math.log2(8.0)} {math.log10(1000.0)}")
println(f"{math.sin(1.0)} {math.cos(1.0)} {math.tan(1.0)}")
println(f"{math.asin(1.0)} {math.acos(0.0)} {math.atan(1.0)}")
println(f"{math.sinh(1.0)} {math.cosh(1.0)} {math.tanh(1.0)}")
println(f"{math.atan2(1.0, 1.0)} {math.hypot(3.0, 4.0)} {math.pow(2.0, 10.0)} {math.pow(2.0, 0.5)}")
println(f"{math.pi} {math.e} {math.tau}")
println(f"{math.abs(-3)} {math.abs(-2.5)} {math.abs(-0.0)} {math.signum(-2.5)} {math.signum(0)} {math.signum(7)}")
let sa = "a"
let sb = "b"
println(f"{math.min(1, 2)} {math.max(1, 2)} {math.min(1.5, 0.5)} {math.max(sa, sb)}")
println(f"{math.gcd(12, 18)} {math.gcd(0, 0)} {math.gcd(-12, 18)} {math.lcm(4, 6)} {math.lcm(0, 3)} {math.lerp(0.0, 10.0, 0.25)} {math.lerp(1.0, 3.0, 1.0)}")
let nan = 0.0 / 0.0
println(f"{math.signum(nan)} {math.min(nan, 1.0)} {math.max(1.0, nan)}")
