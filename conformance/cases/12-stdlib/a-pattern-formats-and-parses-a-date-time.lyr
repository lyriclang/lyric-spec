//! run
//! stdout:
//! | 2026-03-29 03:30:00
//! | Sun, 29 Mar 2026 3:30 AM
//! | Sunday March 29, 26 | 03:30:00.000 +0200
//! | +02 +0200 +02:00 +02 +0200 +02:00 | Z Z Z +00 +0000 +00:00
//! | at 03h '
//! | the pattern letter 'Q' is none of y M d H h m s S a E Z X x
//! | 2026-03-29T03:30:00+02:00 2026-03-29T03:30:00+02:00 2026-03-05T00:00:00Z 1970-01-01T23:05:00Z
//! | refused
//! | 5 of 5
//! since: 5.0.0
// 12 §Time, the zones, rule 3: UTS #35's fields written and read back, the quotes, a letter that
// is none, the zone resolving a text without an offset, five round trips.
import std.io { println };
import std.core { ParseError };
import std.time { Zone, DateTime, Date, Time, TimeError };

fn main(): void throws Error {
    let cet = try Zone.fromPosix("CET", "CET-1CEST,M3.5.0,M10.5.0/3");
    let dt = DateTime.of(try Date.of(2026, 3, 29), try Time.of(3, 30, 0), cet);
    println(try dt.format("yyyy-MM-dd HH:mm:ss"));
    println(try dt.format("EEE, d MMM yyyy h:mm a"));
    println(f"{try dt.format("EEEE MMMM d, yy")} | {try dt.format("HH:mm:ss.SSS Z")}");
    println(f"{try dt.format("X XX XXX x xx xxx")} | {try dt.withZone(Zone.utc).format("X XX XXX x xx xxx")}");
    println(try dt.format("'at' HH'h' ''"));
    try {
        let _ = try dt.format("Q");
    } catch (e: TimeError) {
        println(e.message());
    }
    println(f"{try DateTime.parseWith("yyyy-MM-dd HH:mm Z", "2026-03-29 03:30 +0200")} {try DateTime.parseWith("yyyy-MM-dd HH:mm", "2026-03-29 02:30", cet)} {try DateTime.parseWith("d MMM yyyy", "5 mar 2026")} {try DateTime.parseWith("h:mm a", "11:05 pm")}");
    try {
        let _ = try DateTime.parseWith("yyyy-MM-dd", "2026/03/29");
        println("accepted");
    } catch (_: ParseError) {
        println("refused");
    }
    var ok = 0;
    for (p in ["yyyy-MM-dd HH:mm:ss Z", "EEE, d MMM yyyy h:mm:ss a XXX", "yyyy-MM-dd'T'HH:mm:ss.SSSxxx", "d MMMM yyyy HH:mm ZZZZZ", "yy/M/d H:m:s x"]) {
        if ((try DateTime.parseWith(p, try dt.format(p))) == dt) {
            ok = ok + 1;
        }
    }
    println(f"{ok} of 5");
}
