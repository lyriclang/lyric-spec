//! run
//! stdout:
//! | echoed: hello over tcp
//! since: 5.0.0
// 12 §The network, rules 3–4: a listener on 127.0.0.1 with a port the system chose, a task that
// echoes until the client shuts its writing, the client reading it all back.
import std.io { println };
import std.net { IpAddr, SocketAddr, TcpListener, TcpStream };
import std.task { spawn };

fn main(): void throws Error {
    let listener = try TcpListener.bind(SocketAddr { ip = IpAddr.V4(127, 0, 0, 1), port = 0 });
    let at = try listener.localAddr();
    let server = spawn(() => {
        var conn = try listener.accept();
        let buf: uint8[] = [0u8] * 16;
        loop {
            let n = try conn.read(buf[..]);
            if (n == 0) {
                break;
            }
            try conn.writeAll(buf[..n]);
        }
        try conn.close();
    });
    var client = try TcpStream.connect(at);
    try client.writeString("hello over tcp");
    try client.shutdown(.Write);
    let back = try client.readToString();
    println(f"echoed: {back}");
    try client.close();
    try server.await();
    try listener.close();
}
