//! run
//! option: --allow=file
//! in-temp-dir
//! stdout:
//! | dirs: true true true
//! | files: true 0 true
//! | made all twice: true
//! | from here: true
//! | below it: true
//! | over a file: not a directory: tree-f (made)
//! | nothing there removed: fine
//! since: 1.0.0

// §12 rule 23: two temporary directories and two temporary files are new and distinct; createDirAll makes the parents and finds nothing to do the second time; over a file it says so; removeAll of nothing is nothing to do
import std.fs { createDirAll, metadata, remove, removeAll, tempDir, tempFile, writeText }
import std.path { join, parent }

fn said(f: fn() -> void): string {
    try {
        f()
        return "made"
    } catch (e: IoError) {
        return e.message()
    }
}

let one = tempDir()
let two = tempDir()
println(f"dirs: {one != two} {metadata(one).isDir} {parent(one) == parent(two)}")
let f = tempFile()
let g = tempFile()
println(f"files: {f != g} {metadata(f).size} {parent(f) == parent(one)}")
remove(f)
remove(g)
let deep = join(one, "a", "b", "c")
createDirAll(deep)
createDirAll(deep)
println(f"made all twice: {metadata(deep).isDir}")
createDirAll("here")
println(f"from here: {metadata("here").isDir}")
createDirAll(join("here", "x", "y"))
println(f"below it: {metadata(join("here", "x", "y")).isDir}")
writeText("tree-f", "")
let overFile = said(() => {
    createDirAll("tree-f")
})
println(f"over a file: {overFile}")
removeAll(one)
removeAll(two)
removeAll(join(one, "none"))
println("nothing there removed: fine")
