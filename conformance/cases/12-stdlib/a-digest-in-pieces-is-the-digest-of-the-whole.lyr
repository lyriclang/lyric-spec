//! run
//! stdout:
//! | true true true
//! since: 5.0.0
// 12 §Cryptography, rule 1: pieces of any length, a block's edge among them, hash as the whole;
// 'finish' leaves the digest as it was, so it may be fed further.
import std.crypto { Digest, Sha256 };
import std.encoding { Hex };
import std.io { println, ByteBuffer };

fn utf8(s: string): uint8[] {
    let b = ByteBuffer.new();
    try! b.writeString(s);
    return b.toArray();
}

fn hex<D :: [Digest]>(s: string): string {
    var d = D.new();
    d.update(utf8(s)[..]);
    return Hex.encode(d.finish()[..]);
}

fn main(): void {
    let text = utf8("a" * 300);
    let d = Sha256.new();
    d.update(text[..1]);
    d.update(text[1..65]);
    d.update(text[65..65]);
    d.update(text[65..]);
    let whole = Hex.encode(d.finish()[..]);
    let again = Hex.encode(d.finish()[..]);
    d.update(text[..1]);
    let longer = Hex.encode(d.finish()[..]);
    println(f"{whole == hex<Sha256>("a" * 300)} {again == whole} {longer == hex<Sha256>("a" * 301)}");
}
