// §12 rule 19: a read fills from the front and says how many; a position past the end reads nothing.
import std.io { ByteReader, SeekFrom }
let r = ByteReader.new(b"hello")
let two = Bytes.zeroed(2)
println(r.read(two))
println(two)
println(r.position())
println(r.seek(SeekFrom.End(-1)))
println(r.read(two))
println(two)
println(r.read(two))
println(r.seek(SeekFrom.Start(100)))
println(r.read(two))
println(r.seek(SeekFrom.Start(1)))
println(r.seek(SeekFrom.Current(2)))
println(r.read(Bytes.new()))
println(r.position())
