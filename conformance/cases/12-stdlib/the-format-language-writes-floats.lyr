//! run
//! stdout:
//! | 3.14 2.500 1.234500e+03 1.23E+03 25.0% 1,234,567.89 -0003.50 2.67
//! since: 5.0.0
// 12 §2 rules 1, 3: a float fixed, with a precision and no type fixed, with an exponent, a
// hundredfold, grouped, zero-padded after its sign — rounded on its exact binary digits.
import std.io { println };

fn main(): int {
    println(f"{3.14159:.2f} {2.5:.3} {1234.5:e} {1234.5:.2E} {0.25:.1%} {1234567.891:,.2f} {-3.5:08.2f} {2.675:.2f}");
    return 0;
}
