// §12 rule 17: an element is an `int` wherever one is read
let b = b"abca"
println(b.indexOf(99))
println(b.indexOf(100))
println(b.contains(97))
println(100 in b)
println(b.startsWith(b"ab"))
println(b.startsWith(b"b"))
println(b.startsWith(b"abcab"))
println(b.endsWith(b"ca"))
println(b.endsWith(b"cb"))
println(b.endsWith(b""))
var sum = 0
for (x in b) {
    sum += x
}
println(sum)
println(b.toList())
println(b.iter().map((x) => x + 1).toArray())
println(Bytes.from([1, 2].iter()))
let i = b.iter()
println(i.next())
println(i.nextBack())
println(i.sizeHint())
println(b.reversed())
println(b)
b.reverse()
println(b)
let e = b"abcd"
e.reverse()
println(e)
