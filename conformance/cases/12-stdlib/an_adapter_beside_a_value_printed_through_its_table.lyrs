//! run
//! stdout:
//! | [2, 4]
//! | 1 [3]
//! since: 1.0.0
// §12 rule 3: a program that names an adapter prints through a table too — the Debug forms of
// every type stand, std.iter's classes over open arguments among them.
let xs: int[] = [1, 2].iter().map((x) => x * 2).collect()
println(xs)
let a: Any = 1
let b: Any = [3]
println(f"{a} {b}")
