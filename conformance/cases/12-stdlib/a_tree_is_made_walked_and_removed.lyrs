//! run
//! option: --allow=file
//! in-temp-dir
//! stdout:
//! | A.md a/ a.txt b/ b/c/ b/c/x.txt b/y.txt z.txt
//! | 9 dirs, 6 files, 12 bytes
//! | removed: false, again: fine
//! since: 1.0.0

// §12 rule 23: a tree made in a temporary directory, walked depth first in the byte order of the names, and removed with all in it
import std.fs { createDirAll, exists, removeAll, tempDir, walk, writeText }
import std.path { join, relative }

let t = tempDir()
for (d in ["b/c", "a"]) {
    createDirAll(join(t, d))
}
for (f in ["z.txt", "b/y.txt", "b/c/x.txt", "a.txt", "A.md"]) {
    writeText(join(t, f), f)
}
var out = ""
for (e in walk(t)) {
    let rel = (relative(t, e.path) ?? e.path).replace("\\", "/")
    out = out + (if (out.isEmpty()) "" else " ") + rel + (if (e.isDir) "/" else "")
}
println(out)
let root = join(t, "tree")
for (k in 0..3) {
    for (j in 0..2) {
        createDirAll(join(root, f"d{k}", f"e{j}"))
        writeText(join(root, f"d{k}", f"e{j}", "leaf.txt"), f"{k}{j}")
    }
}
var dirs = 0
var files = 0
var bytes = 0
for (e in walk(root)) {
    if (e.isDir) {
        dirs += 1
    } else if (e.isFile) {
        files += 1
        bytes += e.metadata().size
    }
}
println(f"{dirs} dirs, {files} files, {bytes} bytes")
removeAll(t)
let gone = exists(t)
removeAll(t)
println(f"removed: {gone}, again: fine")
