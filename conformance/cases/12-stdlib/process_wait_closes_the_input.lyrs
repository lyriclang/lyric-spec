//! run
//! option: -A
//! in-temp-dir
//! stdout:
//! | 2 exit code 0
//! since: 1.0.0

// §12 rule 27: `wait()` closes a piped input first: a child that reads to its end ends
import std.fs { writeText }
import std.os
import std.process { Command, Stdio }

// the binary under test, the runner names it: the child is a script
let me = os.env("LYRIC_SCRIPT_UNDER_TEST") ?? "lyric-script"
writeText("child.lyrs", "var n = 0\nwhile (readLine() != null) {\n    n += 1\n}\nprintln(n)\n")
let child = Command { program = me, args = ["run", "-A", "child.lyrs"], stdin = Stdio.Piped, stdout = Stdio.Piped }.spawn()
let into = child.stdin ?? unreachable("piped")
into.writeString("a\nb\n")
let st = child.wait()
let out = child.stdout ?? unreachable("piped")
println(f"{out.readToString().trimEnd()} {st}")
