//! run
//! stdout:
//! | x=1
//! | y=2
//! | z=3
//! | ["x", "y", "z"] [1, 2, 3]
//! | [("x", 1), ("y", 2), ("z", 3)]
//! | {"x!": 10, "y!": 20, "z!": 30}
//! | 3 6
//! | {"x": 2, "y": 3, "z": 4}
//! since: 1.0.0
// §12 rule 5: a map is walked over its entries, `(K, V)`, in the order the keys came — so are
// `keys()`, `values()` and `entries()`; pairs collect into a map; a value written while the map is
// walked is no change.
let m = ["x": 1, "y": 2, "z": 3]
for ((k, v) in m) {
    println(f"{k}={v}")
}
let ks: string[] = m.keys().collect()
let vs: int[] = m.values().collect()
println(f"{ks} {vs}")
let es: (string, int)[] = m.entries().collect()
println(es)
let back: Map<string, int> = es.iter().map((e) => (e.0 + "!", e.1 * 10)).collect()
println(back)
var sum = 0
for (e in m) {
    sum += e.1
}
println(f"{m.iter().count()} {sum}")
for ((k, v) in m) {
    m[k] = v + 1
}
println(m)
