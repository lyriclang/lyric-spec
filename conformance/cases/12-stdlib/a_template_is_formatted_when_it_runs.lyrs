//! run
//! since: 1.0.0
//! stdout:
//! | cart has   12 items
//! | baab|{x}|
//! | 0xff|"q"|**R3***|  q
//! | 3.14 1.234500e+03     c
//! | none
//! | [1, 2]      [3] (1, a)
// §12 rule 12 (Lyric 5 12 §2 rule 5): `std.fmt.format(template, args: Display...)` reads its
// template when it runs, in the f-strings' format language: `{}` the next value, `{i}` the i-th
// from 0 — the two mix, `{}` counting only itself —, either with `:spec`, `?` the Debug text;
// `{{` and `}}` a brace; a value no hole names is left out.
import std.fmt
struct R :: Display {
    v: int
    fn show(): string = f"R{this.v}"
}
let template = "{} has {1:>4} items"
println(fmt.format(template, "cart", 12))
println(fmt.format("{1}{0}{}{}|{{x}}|", "a", "b"))
println(fmt.format("{:#x}|{:?}|{2:*^7}|{1:>3}", 255, "q", R { v = 3 }))
println(fmt.format("{0:.2} {1:e} {2:>5}", 3.14159, 1234.5, 'c'))
println(fmt.format("none"))
println(fmt.format("{} {:>8} {}", [1, 2], [3], (1, "a")))
