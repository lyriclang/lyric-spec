//! run
//! option: -A
//! in-temp-dir
//! stdout:
//! | main goes on
//! | true
//! since: 1.0.0

// §12 rule 27: a wait for a child waits as a file's call does: the other tasks go on
import std.fs { writeText }
import std.os
import std.process { Command, Stdio }

// the binary under test, the runner names it: the child is a script
let me = os.env("LYRIC_SCRIPT_UNDER_TEST") ?? "lyric-script"
writeText("child.lyrs", "sleep(Duration.ofSecs(30))\n")
let child = Command { program = me, args = ["run", "-A", "child.lyrs"] }.spawn()
let t = spawn((): string => f"{child.wait()}")
yieldNow()
println("main goes on")
child.kill()
println(t.await() != "")
