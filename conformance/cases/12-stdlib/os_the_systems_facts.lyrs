//! run
//! option: --allow=os
//! stdout:
//! | true true
//! | true true true true
//! | false
//! | true
//! since: 1.0.0

// §12 rule 26: the platform and the machine by the target triples' words; a process number, a processor, a host name, an
// absolute directory for temporary files
import std.os
import std.path { isAbsolute, separator }

let p = f"{os.platform()}"
let a = f"{os.arch()}"
println(f"{p == "linux" || p == "macos" || p == "windows"} {a == "x86_64" || a == "aarch64"}")
println(f"{os.pid() > 0} {os.cpuCount() >= 1} {!os.hostname().isEmpty()} {isAbsolute(os.tempDir())}")
println(os.platform() == os.Platform.Other)
// the platform is the one it runs on, as far as a case can tell
println((os.platform() == os.Platform.Windows) == (separator == "\\"))
