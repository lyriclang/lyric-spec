//! run
//! option: -A
//! in-temp-dir
//! stdout:
//! | hello world 2 | exit code 0
//! since: 1.0.0

// §12 rule 27: a child with its output piped, read to its end, and waited for; an empty argument is one
import std.fs { writeText }
import std.os
import std.process { Command, Stdio }

// the binary under test, the runner names it: the child is a script
let me = os.env("LYRIC_SCRIPT_UNDER_TEST") ?? "lyric-script"
writeText("child.lyrs", "println(f\"hello {args[0]} {args.length()}\")\n")
let child = Command { program = me, args = ["run", "-A", "child.lyrs", "world", ""], stdout = Stdio.Piped }.spawn()
let out = child.stdout ?? unreachable("piped")
let said = out.readToString()
out.close()
println(f"{said.trimEnd()} | {child.wait()}")
