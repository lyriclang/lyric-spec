// §12 rule 16: from an `int` through `From` and the literal protocol, to an `int` where it fits; to the
// nearest float, a tie to the even one even where the bit deciding it lies far below; past a float's
// range an infinity.
import std.math { BigInt }
let lo = BigInt.from(int.min)
let hi = BigInt.from(int.max)
println(lo)
println(hi)
println((hi + BigInt.one).toInt())
println((lo - BigInt.one).toInt())
println(lo.toInt())
println(hi.toInt())
println(hi + BigInt.one)
println(lo - BigInt.one)
println(BigInt.zero.toFloat())
println(BigInt.parse("1000000000000000000000000000000").toFloat())
println(BigInt.parse("-1000000000000000000000000000000").toFloat())
println(BigInt.parse("9444732965739291475968").toFloat())
println(BigInt.parse("9444732965739291475969").toFloat())
println(BigInt.parse("9903520314283045497727877120").toFloat())
println((BigInt.one << 1024).toFloat())
println((-(BigInt.one << 1024)).toFloat())
println(((BigInt.one << 1024) - (BigInt.one << 970)).toFloat())
println(((BigInt.one << 1024) - (BigInt.one << 971)).toFloat())
let c: BigInt = 7.into()
println(c)
let d: BigInt = 5
println(d)
fn id(v: BigInt): BigInt = v
println(id(5))
