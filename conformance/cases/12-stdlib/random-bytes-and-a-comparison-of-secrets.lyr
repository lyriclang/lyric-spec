//! run
//! stdout:
//! | 0 13 true
//! | true false false true
//! since: 5.0.0
// 12 §Cryptography, rules 4 and 5: as many random bytes as asked; constantTimeEq compares bytes,
// and slices of different lengths are unequal.
import std.crypto { Digest, constantTimeEq, randomBytes, randomUint64 };
import std.encoding { Hex };
import std.io { println, ByteBuffer };

fn utf8(s: string): uint8[] {
    let b = ByteBuffer.new();
    try! b.writeString(s);
    return b.toArray();
}

fn hex<D :: [Digest]>(s: string): string {
    var d = D.new();
    d.update(utf8(s)[..]);
    return Hex.encode(d.finish()[..]);
}

fn main(): void {
    // 64 random bits twice alike: once in 2^64
    println(f"{randomBytes(0).length()} {randomBytes(13).length()} {randomUint64() != randomUint64()}");
    let abc = utf8("abc");
    println(f"{constantTimeEq(abc[..], utf8("abc")[..])} {constantTimeEq(abc[..], utf8("abd")[..])} {constantTimeEq(abc[..2], abc[..])} {constantTimeEq(abc[..0], abc[3..])}");
}
