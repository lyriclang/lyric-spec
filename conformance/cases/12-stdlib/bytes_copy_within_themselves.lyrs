// §12 rule 19: the two may be one, either way round; a search is a range's.
let b = b"abcdef"
b.copyInto(b, 2, 0, 4)
println(b)
let c = b"abcdef"
c.copyInto(c, 0, 2, 6)
println(c)
let d = Bytes.zeroed(3)
b"xyz".copyInto(d, 1, 1, 3)
println(d)
b"xyz".copyInto(d, 3, 0, 0)
println(d)
println(b"abcabc".indexOf(99))
println(b"abc".indexOf(300))
println(b"abc".indexOf(-1))
