//! run
//! option: -A
//! in-temp-dir
//! stdout:
//! | before
//! | child
//! | after true
//! since: 1.0.0

// §12 rule 27: `status()` gives the child the parent's streams; what the parent wrote before comes first
import std.fs { writeText }
import std.os
import std.process { Command, Stdio }

// the binary under test, the runner names it: the child is a script
let me = os.env("LYRIC_SCRIPT_UNDER_TEST") ?? "lyric-script"
writeText("child.lyrs", "println(\"child\")\n")
println("before")
let st = Command { program = me, args = ["run", "-A", "child.lyrs"] }.status()
println(f"after {st.success()}")
