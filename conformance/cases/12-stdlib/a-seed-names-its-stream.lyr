// 12 §Random numbers, rule 1: the stream a seed names — the same in every 5.x —, over the end of
// a block (eight draws a block).
import std.core { arrayOf };
import std.io { println };
import std.random { Random };

fn line(xs: uint64[]): string {
    var out = "";
    for (x in xs) {
        out = if (out.isEmpty()) f"{x}" else f"{out} {x}";
    }
    return out;
}

fn main(): void {
    let a = Random.seeded(0);
    println(line(arrayOf(9, (i) => a.nextUint64())));
    let b = Random.seeded(42);
    println(line(arrayOf(3, (i) => b.nextUint64())));
}
