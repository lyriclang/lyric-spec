//! run
//! stdout:
//! | foo user:pw example.com 8042 /over/there name=ferret nose
//! | foo://user:pw@example.com:8042/over/there?name=ferret#nose
//! | ldap://[2001:db8::7]/c=GB?objectClass?one 2001:db8::7
//! | http://www.example.com/a/~u%2Fx?q#f
//! | a%20b%2Fc%3Fd=%C3%A9 a b/c
//! | 1 ["1", "3"] x y! a=1&b=x%20y%21&a=3&c=
//! | refused refused refused refused refused refused
//! | accepted accepted accepted
//! since: 5.0.0
// 12 §URIs rules 1, 2, 4: the parts of a URI and its text back, an IPv6 host, the normalization, the
// percent-encoding per component, the pairs of a query; what the grammar refuses is refused.
import std.io { println };
import std.uri { Uri, Query, percentEncode, percentDecode };
import std.core { ParseError };

fn verdict(s: string): string {
    try {
        let _ = Uri.parse(s);
        return "accepted";
    } catch (_: ParseError) {
        return "refused";
    }
}

fn main(): void throws Error {
    let u = try Uri.parse("foo://user:pw@example.com:8042/over/there?name=ferret#nose");
    println(f"{u.scheme ?? "-"} {u.userinfo ?? "-"} {u.host ?? "-"} {u.port ?? -1} {u.path} {u.query ?? "-"} {u.fragment ?? "-"}");
    println(u.show());
    let l = try Uri.parse("ldap://[2001:db8::7]/c=GB?objectClass?one");
    println(f"{l.show()} {l.host ?? "-"}");
    println((try Uri.parse("HTTP://www.EXAMPLE.com:80/a/./b/../%7Eu%2fx?q#f")).normalize().show());
    println(f"{percentEncode("a b/c?d=\u{e9}", .Segment)} {try percentDecode("a%20b%2Fc")}");
    let q = try Query.parse("a=1&b=x+y%21&a=3&c");
    println(f"{q.get("a") ?? "-"} {q.all("a")} {q.get("b") ?? "-"} {q.show()}");
    println(f"{verdict("http://a b/")} {verdict("http://[::1")} {verdict("http://h:99999/")} {verdict("http://h/%zz")} {verdict("1http://x")} {verdict("a#b#c")}");
    println(f"{verdict("//h")} {verdict("g:h")} {verdict("http://h:/")}");
}
