//! run
//! stdout:
//! | closed (read)
//! since: 5.0.0
// 12 §The network, rule 5: a task on a thread of its own waits to read a stream the main thread
// then closes — the wait on the other thread ends, and the read throws Closed.
import std.io { IoError, println };
import std.net { IpAddr, SocketAddr, TcpListener, TcpStream };
import std.task { sleep };
import std.thread { Thread };
import std.time { Duration };

fn main(): void throws Error {
    let listener = try TcpListener.bind(SocketAddr { ip = IpAddr.V4(127, 0, 0, 1), port = 0 });
    var client = try TcpStream.connect(try listener.localAddr());
    var conn = try listener.accept();
    let reader = Thread.spawn(() => {
        let buf: uint8[] = [0u8] * 8;
        try {
            let _ = try client.read(buf[..]);
            return "read";
        } catch (e: IoError) {
            return e.message();
        }
    });
    try sleep(Duration.ofMillis(100));
    try client.close();
    println(try reader.await());
    try conn.close();
    try listener.close();
}
