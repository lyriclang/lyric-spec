//! run
//! option: -A
//! in-temp-dir
//! stdout:
//! | true
//! since: 1.0.0

// §12 rule 27: `signal(s)` sends the child `s`, and its end says it; Windows has no such signal: `Unsupported`
import std.fs { writeText }
import std.os
import std.process { Command, Stdio }

// the binary under test, the runner names it: the child is a script
let me = os.env("LYRIC_SCRIPT_UNDER_TEST") ?? "lyric-script"
writeText("child.lyrs", "sleep(Duration.ofSecs(30))\n")
let child = Command { program = me, args = ["run", "-A", "child.lyrs"] }.spawn()
var said = false
try {
    child.signal(os.Signal.Terminate)
    if (let s = child.wait().signal()) {
        said = match (s) {
            .Terminate => true,
            _ => false,
        }
    }
} catch (e: IoError) {
    said = os.platform() == os.Platform.Windows && e.kind == IoErrorKind.Unsupported
    child.kill()
    child.wait()
}
println(said)
