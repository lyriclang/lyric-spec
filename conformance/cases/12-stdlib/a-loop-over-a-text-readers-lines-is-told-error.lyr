//! check
//! error: LYR-SEM0034
//! since: 5.0.0
// 12 §Input and output, rule 7: a TextReader's lines join IoError and Cancelled, which reduces to
// the root Error — a loop over them in a function that covers the two by name is refused.
import std.io { ByteReader, IoError, TextReader };
import std.task { Cancelled };

fn count(bytes: Slice<uint8>): int throws [IoError, Cancelled] {
    var n = 0;
    for (_ in try TextReader.new(ByteReader.new(bytes)).lines()) {
        n = n + 1;
    }
    return n;
}

fn main(): void throws Error {
    let bytes: uint8[] = [97u8];
    let _ = try count(bytes[..]);
}
