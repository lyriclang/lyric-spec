//! run
//! stdout:
//! | [   42] [42   ] [ 42  ] [***42] [  ab] [ x ] [ true] [éé7]
//! since: 5.0.0
// 12 §2 rules 1, 3: width, alignment and fill — a number right-aligned, the rest left-aligned, the
// odd fill after a centred value, the width counted in characters.
import std.io { println };

fn main(): int {
    println(f"[{42:5}] [{42:<5}] [{42:^5}] [{42:*>5}] [{"ab":>4}] [{'x':^3}] [{true:>5}] [{7:é>3}]");
    return 0;
}
