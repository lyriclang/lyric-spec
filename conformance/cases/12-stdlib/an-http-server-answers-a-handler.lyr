//! run
//! stdout:
//! | 200 OK text/plain; charset=utf-8 12 lyric5 [hello, world]
//! | [{"id":1,"name":"one"},{"id":2,"name":"zwei"}]
//! | POST /echo x=1 7 [payload]
//! | chunked [streamed in chunks]
//! | 201 Created /items/3 [made]
//! | 204 No Content []
//! | 404 Not Found [no /nope]
//! | 500 Internal Server Error [not found (the thing is not there)]
//! | 200 OK [hello, world]
//! since: 5.0.0
// 12 §HTTP rule 4: a handler per request - its text, JSON, the request's parts and body, a
// streamed body in chunks, a status with headers, 204, a 404 of the handler's, a 500 for a
// handler that throws - and the connection kept throughout.
import std.io { println, IoError, ByteBuffer };
import std.net { IpAddr, SocketAddr };
import std.task { spawn };
import std.http { Client, Request, Response, Server, Method };
import std.uri { Uri };
import std.codec { Codable };

struct Item :: [Codable] {
    id: int,
    name: string,
}

fn handle(req: Request): Response throws Error {
    let path = req.uri.path;
    if (path == "/hello") {
        return Response.withText("hello, world");
    }
    if (path == "/items") {
        return try Response.withJson([Item { id = 1, name = "one" }, Item { id = 2, name = "zwei" }]);
    }
    if (path == "/echo") {
        let text = try req.text();
        return Response.withText(f"{req.method.show()} {path} {req.uri.query ?? "-"} {text.length()} [{text}]");
    }
    if (path == "/stream") {
        let src = ByteBuffer.new();
        try src.write("streamed in chunks".toBytes()[..]);
        return Response.stream(200, src, null, "text/plain");
    }
    if (path == "/created") {
        var r = Response.withText("made", 201);
        r.headers.set("Location", "/items/3");
        return r;
    }
    if (path == "/nothing") {
        return Response.empty(204);
    }
    if (path == "/fail") {
        throw IoError { kind = .NotFound, path = null, detail = "the thing is not there", inner = null };
    }
    return Response.withText(f"no {path}", 404);
}

fn main(): void throws Error {
    var server = try Server.bind(SocketAddr { ip = IpAddr.V4(127, 0, 0, 1), port = 0 });
    let base = f"http://127.0.0.1:{(try server.localAddr()).port}";
    let _ = spawn(() => { try server.serve(handle); });
    let u = (p: string) => try! Uri.parse(base + p);
    var client = Client.new();
    let r = try client.get(u("/hello"));
    println(f"{r.status.show()} {r.headers.get("Content-Type") ?? "-"} {r.headers.get("Content-Length") ?? "-"} {r.headers.get("Server") ?? "-"} [{try r.text()}]");
    println(try (try client.get(u("/items"))).text());
    println(try (try client.send(Request.post(u("/echo?x=1"), "payload".toBytes()[..], "text/plain"))).text());
    let s = try client.get(u("/stream"));
    println(f"{s.headers.get("Transfer-Encoding") ?? "-"} [{try s.text()}]");
    let c = try client.get(u("/created"));
    println(f"{c.status.show()} {c.headers.get("Location") ?? "-"} [{try c.text()}]");
    for (p in ["/nothing", "/nope", "/fail", "/hello"]) {
        let x = try client.get(u(p));
        println(f"{x.status.show()} [{try x.text()}]");
    }
    client.close();
    server.shutdown();
}
