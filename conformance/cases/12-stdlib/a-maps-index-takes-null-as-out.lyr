//! run
//! stdout:
//! | 3 true 30 true 2
//! since: 5.0.0
// 12 §Collections: Map.from keeps a key's later value; m[k] is the value or null; m[k] = v puts it,
// m[k] = null takes the key out.
import std.collections { Map };
import std.io { println };

fn main(): void {
    let m = Map.from([("a", 1), ("b", 2), ("a", 3)]);
    let a = "a";
    let b = "b";
    let c = "c";
    let first = m[a]!;
    let none = m[c] == null;
    m[c] = 30;
    m[b] = null;
    println(f"{first} {none} {m[c]!} {m[b] == null} {m.entries().count()}");
}
