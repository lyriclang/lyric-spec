//! run
//! stdout:
//! | 2 0 2 1
//! | 3 0
//! since: 5.0.0
// 12 §Input and output, rule 2: 'read' answers 0 only at the end, and at once for an empty slice.
import std.io { println, ByteReader };

fn main(): void {
    let data: uint8[] = [1u8, 2u8, 3u8];
    let r = ByteReader.new(data[..]);
    let two: uint8[] = [0u8] * 2;
    let none: uint8[] = [];
    let a = try! r.read(two[..]);
    let z = try! r.read(none[..]);
    println(f"{a} {z} {r.position()} {try! r.read(two[..])}");
    println(f"{two[0]} {try! r.read(two[..])}");
}
