//! run
//! option: --allow=os
//! stdout:
//! | 2026-03-29T01:59:59+01:00 CET false
//! | 2026-03-29T03:00:00+02:00 CEST true
//! | 2026-03-29T03:30:00+02:00 gap
//! | 2026-10-25T02:30:00+02:00 overlap
//! | 2026-03-29T12:00:00+02:00 23
//! | 2026-10-25T12:00:00+01:00 25
//! | 2040-03-11T03:00:00-04:00 EDT
//! | 2040-11-04T01:00:00-05:00 EST
//! | CET true 2026-03-29T01:30:00Z 2026-03-28T21:30:00-04:00
//! | true false false false true
//! | true true
//! | 2262-01-01T12:00:00+01:00 1678-01-01T12:00:00+01:00
//! since: 1.0.0

// §12 rule 31: a zone of a POSIX rule at the change of its clocks (Lyric 5 12 §Time, the zones, rules 1–2):
// the gap forward, the overlap earlier, a day across a change 23 or 25 hours, New York by the US rule far
// ahead; a date-time keeps its zone; zones are equal by name, offset and kind, date-times by their offset; the
// years an `Instant` reaches resolve to their ends
import std.time { Date, DateTime, Instant, Time, Zone }

fn at(zone: Zone, text: string): string {
    let dt = Instant.parse(text).toDateTime(zone)
    let info = dt.zoneInfo()
    return f"{dt} {info.abbreviation} {info.isDst}"
}

fn hours(a: DateTime, b: DateTime): int = b.toInstant().since(a.toInstant()).secs() / 3600

let cet = Zone.fromPosix("CET", "CET-1CEST,M3.5.0,M10.5.0/3")
println(at(cet, "2026-03-29T00:59:59Z"))
println(at(cet, "2026-03-29T01:00:00Z"))
let gap = DateTime.of(Date.of(2026, 3, 29), Time.of(2, 30, 0), cet)
println(f"{gap} gap")
println(f"{DateTime.of(Date.of(2026, 10, 25), Time.of(2, 30, 0), cet)} overlap")
let spring = DateTime.of(Date.of(2026, 3, 28), Time.of(12, 0, 0), cet)
println(f"{spring.plusDays(1)} {hours(spring, spring.plusDays(1))}")
let autumn = DateTime.of(Date.of(2026, 10, 24), Time.of(12, 0, 0), cet)
println(f"{autumn.plusDays(1)} {hours(autumn, autumn.plusDays(1))}")
let ny = Zone.fromPosix("America/New_York", "EST5EDT,M3.2.0,M11.1.0")
let first = Instant.parse("2040-03-11T07:00:00Z")
let second = Instant.parse("2040-11-04T06:00:00Z")
println(f"{first.toDateTime(ny)} {first.toDateTime(ny).zoneInfo().abbreviation}")
println(f"{second.toDateTime(ny)} {second.toDateTime(ny).zoneInfo().abbreviation}")
println(f"{gap.zone().name()} {gap.zone() == cet} {gap.withZone(Zone.utc)} {gap.withZone(ny)}")
let same = Zone.fromPosix("CET", "CET-1CEST,M3.5.0,M10.5.0/3")
let renamed = Zone.fromPosix("Berlin", "CET-1CEST,M3.5.0,M10.5.0/3")
let ruledUtc = Zone.fromPosix("UTC", "UTC0")
let plusOne = Zone.fixed(Duration.ofHours(1))
println(f"{same == cet} {renamed == cet} {ruledUtc == Zone.utc} {ruledUtc.isFixed()} {Zone.utc.isFixed()}")
let winter = Date.of(2026, 1, 15)
let noon = Time.of(12, 0, 0)
println(f"{DateTime.of(winter, noon, cet) == DateTime.of(winter, noon, plusOne)} {cet.offset() == cet.offsetAt(Instant.now())}")
let late = DateTime.of(Date.of(2262, 1, 1), noon, cet)
let early = DateTime.of(Date.of(1678, 1, 1), noon, cet)
println(f"{late} {early}")
