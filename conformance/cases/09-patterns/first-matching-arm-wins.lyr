//! run
//! stdout:
//! | first range guarded
//! since: 5.0.0
// 09 §1.3: arms are tried in order and the first that matches wins; a guard runs with the
// pattern's bindings and keeps the arm only when it holds.
import std.io { println };

fn pick(n: int): string {
    return match (n) {
        0 | 1 => "first",
        1..=5 => "range",
        m if m > 100 => "guarded",
        _ => "rest",
    };
}

fn main(): int {
    println(pick(1) + " " + pick(3) + " " + pick(200));
    return 0;
}
