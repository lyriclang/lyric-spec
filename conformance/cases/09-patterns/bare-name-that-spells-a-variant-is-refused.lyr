//! check
//! error: LYR-SEM0111
//! since: 5.0.0
// 09 §2.2: a bare name that spells a variant of the scrutinee's enum would bind every value
// under the variant's name; it is refused, and the diagnostic names '.Red' and 'Signal.Red'.
enum Signal { Red, Yellow, Green }

fn code(s: Signal): int {
    return match (s) {
        Red => 0,
        _ => 1,
    };
}

fn main(): int { return code(Signal.Green); }
