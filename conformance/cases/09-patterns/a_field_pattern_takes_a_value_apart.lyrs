//! run
//! stdout:
//! | 1 2
//! | 5 6
//! | 34
//! since: 1.0.0
// §9 rule 2: without `else`, `let` takes what cannot fail — a field pattern over a struct of
// patterns that cannot fail too, at the top and nested.
struct P {
    x: int,
    y: int,
}
let P { x, y } = P { x = 1, y = 2 }
println(f"{x} {y}")
let (a, P { x = b, y = _ }) = (5, P { x = 6, y = 7 })
println(f"{a} {b}")
fn f(p: P): int {
    let P { x, y } = p
    return x * 10 + y
}
println(f(P { x = 3, y = 4 }))
