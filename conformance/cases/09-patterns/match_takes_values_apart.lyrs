//! | 8
// §9 rule 1 (Lyric 5 §9 §2): variants by position and by field, literals, ranges, guards,
// alternatives that bind, tuples and fields — a match as a value.
enum Shape {
    Circle(int)
    Rect { w: int, h: int }
    Empty
}
enum E {
    A(int), B(int), C
}
struct P {
    x: int
    y: int
}
fn area(s: Shape): int = match (s) {
    .Circle(r) => 3 * r * r,
    .Rect { w, h } => w * h,
    .Empty => 0,
}
fn k(n: int): int = match (n) {
    0 => 100,
    1 | 2 => 200,
    3..=9 => 300,
    m if m < 0 => 400,
    _ => 500,
}
fn e(x: E): int = match (x) {
    .A(v) | .B(v) => v,
    .C => 0,
}
fn t(p: (int, string)): int = match (p) {
    (0, _) => 1,
    (_, "x") => 2,
    (n, _) => n,
}
fn f(p: P): int = match (p) {
    P { x = 0, y } => y,
    P { x, y } => x + y,
}
println(area(Shape.Circle(2)) + area(Shape.Rect { w = 3, h = 4 }) + area(Shape.Empty))
println(area(.Rect { w = 2, h = 5 }) + area(.Circle(1)))
println(k(0) + k(2) + k(5) + k(-3) + k(50))
println(e(E.A(3)) + e(E.B(4)) + e(E.C))
println(t((0, "a")) * 100 + t((5, "x")) * 10 + t((7, "y")))
println(f(P { x = 0, y = 5 }) + f(P { x = 1, y = 2 }))
