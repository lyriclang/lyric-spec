//! check
//! warning: LYR-SEM0172
//! since: 5.0.0
// 10 §1 rule 1: a 'mut fn' generator on a struct changes a copy of 'this' - allowed, and warned
// about where it is declared.
struct Counter {
    var n: int,

    mut fn count(): Coroutine<int> {
        this.n += 1;
        yield this.n;
    }
}

fn main(): void {
}
