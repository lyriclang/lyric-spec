//! check
//! error: LYR-SEM0034
//! since: 5.0.0
// 10 §1 rule 6: a pull throws each type of its set; one left uncovered is refused.
import std.io { println };

struct A :: [Error] { fn message(): string { return "a"; } }
struct B :: [Error] { fn message(): string { return "b"; } }

fn two(): Coroutine<int> throws [A, B] { yield 1; throw B { }; }

fn main(): void {
    let c = two();
    try {
        println(c.next() ?? 0);
    } catch (e: A) {
        println("A");
    }
}
