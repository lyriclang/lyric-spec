//! run
//! panic: LYR-RT0014
//! since: 5.0.0
// 10 §1.9: closing a coroutine that runs — here from its own body — panics.
class Holder { var co: ?Coroutine<int> }

fn selfish(h: Holder): Coroutine<int> {
    h.co!.close();
    yield 1;
}

fn main(): int {
    let h = Holder { co = null };
    let c = selfish(h);
    h.co = c;
    return c.next() ?? 0;
}
