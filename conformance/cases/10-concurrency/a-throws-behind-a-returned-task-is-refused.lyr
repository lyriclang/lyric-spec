//! check
//! error: LYR-SEM0165
//! since: 5.0.0
// 10 §2 rule 8: 'Task<int> throws Oops' as a return type - the task's error, or the function's
// own? Without parentheses it is refused, and that is the one thing said: the body is not held
// to either reading.
import std.task { spawn, Task };

enum Oops :: [Error] {
    Bad;
    fn message(): string { return "oops"; }
}

fn risky(fail: bool): int throws Oops {
    if (fail) { throw Oops.Bad; }
    return 7;
}

fn launch(): Task<int> throws Oops {
    return spawn(() => try risky(false));
}

fn main(): void {
}
