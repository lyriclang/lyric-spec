//! run
//! stdout:
//! | none
//! | 0 1
//! | total 2
//! since: 5.0.0
// 10 §1.3, §1.5: the body's 'return v' gives the result; 'result()' is null until the body has
// returned.
import std.io { println };

fn count(n: int): Coroutine<int, string> {
    var i = 0;
    while (i < n) {
        yield i;
        i += 1;
    }
    return f"total {n}";
}

fn main(): void {
    let c = count(2);
    println(c.result() ?? "none");
    let a = c.next()!;
    let b = c.next()!;
    println(f"{a} {b}");
    let end = c.next();
    println(if (end == null) c.result() ?? "none" else "not the end");
}
