//! run
//! stdout:
//! | 1
//! | caught
//! since: 5.0.0
// 10 §1 rule 6: a coroutine of a set fits where the bare 'throws' covers it, as a function value
// does.
import std.io { println };

struct A :: [Error] { fn message(): string { return "a"; } }
struct B :: [Error] { fn message(): string { return "b"; } }

fn two(): Coroutine<int> throws [A, B] { yield 1; throw B { }; }

fn drain(c: Coroutine<int> throws): void throws {
    var n = try c.next();
    while (n != null) {
        println(n);
        n = try c.next();
    }
}

fn main(): void {
    try {
        drain(two());
    } catch (e: Error) {
        println("caught");
    }
}
