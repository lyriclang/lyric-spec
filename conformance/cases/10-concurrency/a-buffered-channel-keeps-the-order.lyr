//! run
//! stdout:
//! | 1 2 3
//! since: 5.0.0
// 10 §6 rules 1-3: a buffered channel takes sends while there is room, and gives the values in the
// order they were sent.
import std.io { println };
import std.task { spawn, spawnDetached, yieldNow, Channel, ChannelClosed, Cancelled };

fn main(): void throws Error {
    let ch = Channel<int>.new(3);
    try ch.send(1);
    try ch.send(2);
    try ch.send(3);
    let a = try ch.recv();
    let b = try ch.recv();
    let c = try ch.recv();
    println(f"{a ?? 0} {b ?? 0} {c ?? 0}");
}
