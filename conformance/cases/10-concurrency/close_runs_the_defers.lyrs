//! run
//! since: 1.0.0
//! stdout:
//! | 1
//! | cleaned
//! | true
//! | true
// §10 rule 9: the yield the coroutine parked at throws `Cancelled`; its defers run on the way out.
fn gen(): Coroutine<int> {
    defer {
        println("cleaned")
    }
    yield 1
    yield 2
}
let c = gen()
println(c.next() ?? 0)
c.close()
println(c.isDone())
println(c.next() == null)
