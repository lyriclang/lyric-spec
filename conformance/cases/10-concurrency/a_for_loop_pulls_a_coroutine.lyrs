// §10 rule 8: the coroutine is evaluated once and pulled until it ends; `break` and `continue`.
fn count(n: int): Coroutine<int> {
    var i = 0
    while (i < n) {
        i += 1
        yield i
    }
}
var s = 0
for (x in count(10)) {
    if (x == 3) {
        continue
    }
    if (x > 5) {
        break
    }
    s += x
}
println(s)
