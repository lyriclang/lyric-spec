//! run
//! panic: LYR-RT0008
//! stdout:
//! | main goes on
//! since: 5.0.0
// 10 §5 rules 1-2: the task's panic ends that task only — main goes on — and await on the panicked
// task panics again, with the panic's report.
import std.io { println };
import std.task { spawn, yieldNow, Cancelled };

fn main(): void throws Cancelled {
    let bad = spawn(() => {
        panic("boom");
    });
    try yieldNow();
    println("main goes on");
    try bad.await();
    println("after");
}
