//! run
//! stdout:
//! | 1
//! | B
//! since: 5.0.0
// 10 §1 rule 6: the clause is a set, so a clause for each of its types covers a pull.
import std.io { println };

struct A :: [Error] { fn message(): string { return "a"; } }
struct B :: [Error] { fn message(): string { return "b"; } }

fn two(): Coroutine<int> throws [A, B] { yield 1; throw B { }; }

fn main(): void {
    let c = two();
    try {
        println(c.next() ?? 0);
        println(c.next() ?? 0);
    } catch (e: A) {
        println("A");
    } catch (e: B) {
        println("B");
    }
}
