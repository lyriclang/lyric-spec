//! run
//! stdout:
//! | cancelled
//! since: 5.0.0
// 10 §9 rule 1: cancel() on a thread's task ends its wait there (§3).
import std.io { println };
import std.task { sleep, Cancelled };
import std.thread { Thread };
import std.time { Duration };

fn main(): void throws Error {
    let sleeper = Thread.spawn(() => {
        try sleep(Duration.ofSecs(60));
    });
    sleeper.cancel();
    try {
        sleeper.await();
    } catch (_: Cancelled) {
        println("cancelled");
    }
}
