//! run
//! stdout:
//! | done
//! since: 5.0.0
// 10 §2 rule 1: the program ends with main; a task still asleep never runs again, and its
// defer does not run either.
import std.io { println };
import std.task { sleep, yieldNow, spawnDetached, Cancelled };
import std.time { Duration };

fn main(): void {
    spawnDetached(() => {
        defer println("deferred");
        try sleep(Duration.ofSecs(30));
        println("woke");
    });
    try yieldNow();
    println("done");
}
