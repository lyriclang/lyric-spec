//! run
//! panic: LYR-RT0014
//! since: 5.0.0
// 10 §1.13: such a yield's value meets the running coroutine's yield type at run time — a value of
// another type panics.
import std.task { Cancelled };

fn emit(): void throws Cancelled {
    yield "text";
}

fn numbers(): Coroutine<int> {
    yield 1;
    try emit();
}

fn main(): int {
    let n = numbers();
    let a = n.next() ?? 0;
    let b = n.next() ?? 0;
    return a + b;
}
