//! run
//! stdout:
//! | a1 b1 a2 b2
//! since: 5.0.0
// 10 §9 rule 3: the tasks a thread's task starts run on that thread's scheduler, in turn (§2).
import std.task { spawn, yieldNow, Thread };
import std.io { println };

fn main(): void throws Error {
    let worker = Thread.spawn(() => {
        var log = "";
        let a = spawn(() => {
            log = log + "a1 ";
            try yieldNow();
            log = log + "a2 ";
        });
        let b = spawn(() => {
            log = log + "b1 ";
            try yieldNow();
            log = log + "b2";
        });
        try a.await();
        try b.await();
        return log;
    });
    let log = try worker.await();
    println(log);
}
