//! run
//! stdout:
//! | caught
//! | cancelled again
//! since: 5.0.0
// 10 §3 rule 1: the mark stays — a task that catches Cancelled and waits again gets it again.
import std.io { println };
import std.task { spawn, sleep, yieldNow, Cancelled };
import std.time { Duration };

fn main(): void throws Cancelled {
    let stubborn = spawn(() => {
        try {
            sleep(Duration.ofSecs(30));
        } catch (_: Cancelled) {
            println("caught");
        }
        try sleep(Duration.ofMillis(1));
        println("slept");
    });
    try yieldNow();
    stubborn.cancel();
    try {
        stubborn.await();
    } catch (_: Cancelled) {
        println("cancelled again");
    }
}
