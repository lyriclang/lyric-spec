//! run
//! stdout:
//! | done
//! since: 5.0.0
// 10 §9 rule 2: the program ends with main, whatever its threads still do.
import std.io { println };
import std.task { sleep };
import std.thread { Thread };
import std.time { Duration };

fn main(): void {
    Thread.spawn(() => {
        try sleep(Duration.ofHours(1));
    });
    println("done");
}
