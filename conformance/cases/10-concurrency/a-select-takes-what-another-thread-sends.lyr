//! run
//! stdout:
//! | second 42
//! since: 5.0.0
// 10 §7 rule 2: a select waits on channels that other threads send to.
import std.io { println };
import std.task { Channel, Select };
import std.thread { Thread };

fn main(): void throws Error {
    let first = Channel<int>.new();
    let second = Channel<int>.new();
    let sender = Thread.spawn(() => {
        try second.send(42);
    });
    try Select.on(first) { println(f"first {it!}"); }.on(second) { println(f"second {it!}"); }.run();
    try sender.await();
}
