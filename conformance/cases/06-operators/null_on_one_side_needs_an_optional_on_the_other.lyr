//! check
//! since: 4.6.0
//! error: LYR-SEM0059
// §6.2: a non-optional is never null, so the test asks a question the type has answered. It is
// refused rather than folded to 'false' -- and it is refused by the CHECKER: until 4.6.0 the
// lowering answered LYR-IR0001, a code §12.1 keeps for valid Lyric.
fn main(): int {
    let x = 1;
    if (x == null) { return 1; }
    return 0;
}
