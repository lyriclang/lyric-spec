//! run
//! exit: 0
fn main(): int {
    // Spec 6.1: & before ^ before |, all after the ranges; shifts on level 6.
    let masked = 6 & 3 ^ 1 | 8;
    let shifted = 1 << 3 >> 1;
    let inverted = ~0;
    if (masked == 11 && shifted == 4 && inverted == -1) {
        return 0;
    }
    return 1;
}
