//! run
//! exit: 9
import std.core { Exception };

fn risky(): int throws Exception {
    throw Exception { text = "boom" };
}

fn main(): int {
    try {
        return risky();
    } catch (e) {
        // The typeless catch binds 'e' as Throwable and catches everything reaching it.
        // The explicitly written form is the sibling case
        // 'catch_explicit_throwable_is_the_catch_all.lyr'.
        return 9;
    }
}
